{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "plugins": [
    "./node_modules/@catenarycloud/linteffect/rules/no-react-state.grit",
    "./node_modules/@catenarycloud/linteffect/rules/no-render-side-effects.grit",
    "./node_modules/@catenarycloud/linteffect/rules/no-atom-registry-effect-sync.grit",
    "./node_modules/@catenarycloud/linteffect/rules/no-family-collection-read.grit",
    "./node_modules/@catenarycloud/linteffect/rules/no-inline-runtime-provide.grit",
    "./node_modules/@catenarycloud/linteffect/rules/no-naked-object-state-update.grit",
    "./node_modules/@catenarycloud/linteffect/rules/no-empty-vanilla-extract-style.grit",
    "./node_modules/@catenarycloud/linteffect/rules/no-vanilla-extract-export-alias.grit",
    "./node_modules/@catenarycloud/linteffect/rules/no-vanilla-extract-class-map.grit",
    "./node_modules/@catenarycloud/linteffect/rules/no-shared-element-style-import.grit",
    "./node_modules/@catenarycloud/linteffect/rules/no-local-field-style-contract.grit",
    "./node_modules/@catenarycloud/linteffect/rules/no-storybook-inline-test-harness.grit",
    "./node_modules/@catenarycloud/linteffect/rules/no-direct-single-axis-recipe.grit"
  ]
}
