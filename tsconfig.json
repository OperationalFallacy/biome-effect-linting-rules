{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node"
    ],
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    ".projenrc.ts",
    "bin/**/*.mjs",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "vitest.config.mts",
    "tests/support/**/*.ts",
    "tests/**/*.test.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "refs",
    ".local"
  ]
}
