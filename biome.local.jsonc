{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "extends": [
    "./biome.base.jsonc"
  ],
  "plugins": [
    "./rules/no-layer-this-reference.grit",
    "./rules/no-react-state.grit",
    "./rules/no-if-statement.grit",
    "./rules/no-switch-statement.grit",
    "./rules/no-ternary.grit",
    "./rules/no-return-null.grit",
    "./rules/no-pipe-ladder.grit",
    "./rules/no-flatmap-ladder.grit",
    "./rules/no-effect-ladder.grit",
    "./rules/no-nested-effect-call.grit",
    "./rules/no-effect-as.grit",
    "./rules/no-effect-wrapper-alias.grit",
    "./rules/no-call-tower.grit",
    "./rules/no-option-as.grit",
    "./rules/no-arrow-ladder.grit",
    "./rules/no-branch-in-object.grit",
    "./rules/no-iife-wrapper.grit",
    "./rules/no-return-in-arrow.grit",
    "./rules/warn-native-collections.grit",
    "./rules/no-atom-registry-effect-sync.grit",
    "./rules/no-family-collection-read.grit",
    "./rules/no-inline-runtime-provide.grit",
    "./rules/no-effect-never.grit",
    "./rules/no-effect-type-alias.grit",
    "./rules/no-effect-async.grit",
    "./rules/no-effect-sync-console.grit",
    "./rules/no-effect-do.grit",
    "./rules/no-effect-bind.grit",
    "./rules/no-nested-effect-gen.grit",
    "./rules/no-runtime-runfork.grit",
    "./rules/no-match-void-branch.grit",
    "./rules/no-match-effect-branch.grit",
    "./rules/warn-effect-sync-wrapper.grit",
    "./rules/no-effect-side-effect-wrapper.grit",
    "./rules/no-effect-all-step-sequencing.grit",
    "./rules/no-effect-step-const-staging.grit",
    "./rules/no-fragmented-const-assembly.grit",
    "./rules/no-pipeline-fragment-staging.grit",
    "./rules/no-manual-data-guard.grit",
    "./rules/no-effect-orElse-ladder.grit",
    "./rules/no-render-side-effects.grit",
    "./rules/no-naked-object-state-update.grit",
    "./rules/no-return-in-callback.grit",
    "./rules/no-model-overlay-cast.grit",
    "./rules/no-unknown-boolean-coercion-helper.grit",
    "./rules/no-fromnullable-nullish-coalesce.grit",
    "./rules/no-option-boolean-normalization.grit",
    "./rules/no-try-catch.grit",
    "./rules/no-string-sentinel-return.grit",
    "./rules/no-string-sentinel-const.grit",
    "./rules/no-manual-effect-channels.grit",
    "./rules/prevent-dynamic-imports.grit",
    "./rules/no-empty-vanilla-extract-style.grit",
    "./rules/no-vanilla-extract-export-alias.grit"
  ]
}
