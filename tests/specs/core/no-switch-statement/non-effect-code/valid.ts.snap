{
  "input": "/**\n * Correctly uses ordinary branching in a module outside Effect composition.\n * The function has no effectful operation or service dependencies.\n */\nexport const describePhase = (phase: \"ready\" | \"loading\" | \"failed\") => {\n  switch (phase) {\n    case \"ready\":\n      return \"Ready\";\n    case \"loading\":\n      return \"Loading\";\n    default:\n      return \"Failed\";\n  }\n};\n",
