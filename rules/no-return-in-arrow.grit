language js(typescript, jsx)

or {
    `$callee(($params) => { $block })` as $call where {
        $callee <: not `S.filter`,
        $callee <: not `Schema.filter`,
        $block <: contains `return $value` as $ret
    },
    `$callee(($params): $return => { $block })` as $call where {
        $callee <: not `S.filter`,
        $callee <: not `Schema.filter`,
        $block <: contains `return $value` as $ret
    },
    `$callee($param => { $block })` as $call where {
        $callee <: not `S.filter`,
        $callee <: not `Schema.filter`,
        $block <: contains `return $value` as $ret
    },
    `$callee($before, ($params) => { $block })` as $call where {
        $callee <: not `S.filter`,
        $callee <: not `Schema.filter`,
        $block <: contains `return $value` as $ret
    },
    `$callee($before, ($params): $return => { $block })` as $call where {
        $callee <: not `S.filter`,
        $callee <: not `Schema.filter`,
        $block <: contains `return $value` as $ret
    },
    `$callee($before, $param => { $block })` as $call where {
        $callee <: not `S.filter`,
        $callee <: not `Schema.filter`,
        $block <: contains `return $value` as $ret
    },
    `$callee($before, ($params) => { $block }, $after)` as $call where {
        $callee <: not `S.filter`,
        $callee <: not `Schema.filter`,
        $block <: contains `return $value` as $ret
    },
    `$callee($before, ($params): $return => { $block }, $after)` as $call where {
        $callee <: not `S.filter`,
        $callee <: not `Schema.filter`,
        $block <: contains `return $value` as $ret
    },
    `$callee($before, $param => { $block }, $after)` as $call where {
        $callee <: not `S.filter`,
        $callee <: not `Schema.filter`,
        $block <: contains `return $value` as $ret
    }
} where {
    register_diagnostic(
        span = $ret,
        message = "This rule asks you to review a callback with an explicit return. Read its role in the operation and check whether the data, state, or collection choices can be clearer. For example, a reducer that copies a native Map on every step may be clearer as an Effect HashMap update with HashMap.set. Use an expression for a single result, and keep the block when local bindings or several steps explain the operation better.",
        severity = "info"
    )
}
