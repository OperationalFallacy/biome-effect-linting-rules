file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    $body <: contains bubble `($fn)($args)` as $call where {
        or {
            $fn <: `($params) => $expr`,
            $fn <: `($params) => { $block }`,
            $fn <: `$param => $expr`,
            $fn <: `$param => { $block }`,
            $fn <: `function ($params) { $block }`,
            $fn <: `function $name($params) { $block }`
        },
        register_diagnostic(
            span = $call,
            message = "Remove the immediately invoked function and express its work directly in the operation. The extra function body makes the decision and execution order harder to follow. Bind intermediate values with const, select the result with Match or Option, and continue in one pipeline.",
            severity = "error"
        )
    }
}
