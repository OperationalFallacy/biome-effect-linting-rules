file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    $body <: contains bubble `($fn)($args)` as $call where {
        or {
            $fn <: `($params) => $expr`,
            $fn <: `($params) => { $block }`,
            $fn <: `$param => $expr`,
            $fn <: `$param => { $block }`,
            $fn <: `function ($params) { $block }`,
            $fn <: `function $name($params) { $block }`
        },
        register_diagnostic(
            span = $call,
            message = "This inline function is called immediately, which adds another function body to read before the operation becomes clear. Assign its intermediate values to local constants, select the result with Match or Option, and continue in one pipeline.",
            severity = "error"
        )
    }
}
