file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect/atom-react"`
    },
    or {
        $body <: contains `Option.match($input, { onSome: ($value) => $value === true, onNone: () => false })` as $call,
        $body <: contains `Option.match($input, { onSome: ($value: $type) => $value === true, onNone: () => false })` as $call
    },
    register_diagnostic(
        span = $call,
        message = "Define this boolean's default in its Schema instead of normalizing it with Option.match in service logic. Repeated local conversions spread the default policy across services. Decode the input once and use the resulting boolean. Preserve the existing mapping of Some(true) to true, Some(false) to false, and None to false.",
        severity = "error"
    )
}
