file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    or {
        $body <: contains `Option.match($input, { onSome: ($value) => $value === true, onNone: () => false })` as $call,
        $body <: contains `Option.match($input, { onSome: ($value: $type) => $value === true, onNone: () => false })` as $call
    },
    register_diagnostic(
        span = $call,
        message = "This Option.match converts an optional value to a boolean inside the operation. Repeated conversions spread the default-value policy across services. Define that policy once in the schema, then read the resulting boolean in the service.",
        severity = "error"
    )
}
