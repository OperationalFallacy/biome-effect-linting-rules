language js(typescript, jsx)

or {
    `$callee(function $name($params) { $block })`,
    `$callee($before, function $name($params) { $block })`,
    `$callee($before, function $name($params) { $block }, $after)`
} where {
    $block <: contains `return $value` as $ret,
    register_diagnostic(
        span = $ret,
        message = "This callback uses a function body and an explicit return for its result. An expression callback can make a single transformation easier to read. Use an expression callback for a single result. Keep a block when an Effect branch needs local bindings.",
        severity = "info"
    )
}
