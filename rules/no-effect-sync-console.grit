file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect/atom-react"`
    },
    or {
        $body <: contains `Effect.sync($fn)` as $call,
        $body <: contains `Effect.sync<$types>($fn)` as $call
    },
    $fn <: contains `console.$method($_)`,
    register_diagnostic(
        span = $call,
        message = "Use Effect logging operations instead of console calls inside Effect.sync. Console logging bypasses Effect's log context and levels. Replace the call with Effect.log, Effect.logDebug, or the appropriate Effect logging operation. Remove logs that serve no purpose.",
        severity = "error"
    )
}
