file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    or {
        $body <: contains `Effect.sync($fn)` as $call,
        $body <: contains `Effect.sync<$types>($fn)` as $call
    },
    $fn <: contains `console.$method($_)`,
    register_diagnostic(
        span = $call,
        message = "This console call is wrapped in Effect.sync, so it misses the log context and level handling provided by Effect's logging operations. Replace this console call with Effect.log, Effect.logDebug, or another Effect logging operation, or remove it if the log is unnecessary.",
        severity = "error"
    )
}
