language js(typescript, jsx)

file($body) where {
    $body <: contains `"@vanilla-extract/css"`,
    or {
        $body <: contains `const $value = style($definition)`,
        $body <: contains `export const $value = style($definition)`,
        $body <: contains `const $value = styleVariants($definition)`,
        $body <: contains `export const $value = styleVariants($definition)`
    },
    $body <: contains `export const $name = $value;` as $exportAlias,
    register_diagnostic(
        span = $exportAlias,
        message = "This alias exposes a second name for the same generated class, so consumers can use different names for one element's styles. Export this generated class under one name that describes its role and update its consumers to use that name. Define any variants in the Vanilla Extract declaration.",
        severity = "error"
    )
}
