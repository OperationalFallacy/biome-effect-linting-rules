language js(typescript, jsx)

// This rule makes a static service layer identify its class and constructor.
// Callable factories and other objects retain their own receiver semantics.
`Layer.effect($key, $make)` as $call where {
  or { $key <: `this`, $make <: `this.make` },
  $call <: within JsPropertyClassMember(modifiers=$modifiers) as $field where {
    $modifiers <: contains JsStaticModifier()
  } until or {
    JsFunctionExpression(),
    JsArrowFunctionExpression(),
    JsClassDeclaration(),
    JsClassExpression()
  },
  $field <: within JsClassDeclaration(id=$class, extends_clause=$extends) where {
    $extends <: contains `Context.Service`
  } until or {
    JsClassDeclaration(),
    JsClassExpression()
  },
  or {
    and { $key <: `this`, $explicitKey = $class },
    and { $key <: not `this`, $explicitKey = $key }
  },
  or {
    and {
      $make <: `this.make`,
      $explicitMake = join(list=[$class, ".make"], separator="")
    },
    and { $make <: not `this.make`, $explicitMake = $make }
  },
  $message = join(list=[
    "Use Layer.effect(", $explicitKey, ", ", $explicitMake,
    ") in this static declaration. This package requires explicit class references so the service key and constructor are visible. Preserve the factory and layer dependencies.",
  ], separator=""),
  register_diagnostic(span=$call, message=$message, severity="error")
}
