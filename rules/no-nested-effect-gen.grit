file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    $body <: contains bubble `Effect.gen(function* () { $outer })` where {
        $outer <: contains `Effect.gen($_)` as $nested,
        register_diagnostic(
            span = $nested,
            message = "This Effect.gen contains another generator, so the reader must move between generator bodies to follow one operation. Combine these generators into one Effect.gen, or express the steps in one pipeline.",
            severity = "error"
        )
    }
}
