file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    $body <: contains bubble `Effect.gen(function* () { $outer })` where {
        $outer <: contains `Effect.gen($_)` as $nested,
        register_diagnostic(
            span = $nested,
            message = "Combine nested generators into one Effect.gen per method or one pipeline. Separate generator bodies split one operation's sequence and make its execution order harder to follow. Keep the yields together and preserve dependencies, failure handling, and cleanup.",
            severity = "error"
        )
    }
}
