file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    $body <: contains JsSwitchStatement() as $switch,
    register_diagnostic(
        span = $switch,
        message = "This rule flags switch statements in Effect code because separate case bodies can split one operation into several sequences. Express these cases with Match.value, Option.match, Either.match, or Effect.if, then continue the Effect pipeline.",
        severity = "error"
    )
}
