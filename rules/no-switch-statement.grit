file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    $body <: contains JsSwitchStatement() as $switch,
    register_diagnostic(
        span = $switch,
        message = "Replace the switch statement with Match.value, Option.match, Either.match, or Effect.if. Separate case bodies split the operation into branch-local sequences. Select the result first, then continue in one Effect pipeline. Preserve every case and its behavior.",
        severity = "error"
    )
}
