language js(typescript, jsx)

`style({})` as $emptyStyle where {
    register_diagnostic(
        span = $emptyStyle,
        message = "Rule: remove empty Vanilla Extract declarations. Why: an empty generated class creates a styling placeholder with no visual contract and lets consumers depend on unfinished styling. Fix: remove the declaration and className use, or define the complete token-backed element styling before exposing it.",
        severity = "error"
    )
}
