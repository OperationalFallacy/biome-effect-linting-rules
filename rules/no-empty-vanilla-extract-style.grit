language js(typescript, jsx)

`style({})` as $emptyStyle where {
    register_diagnostic(
        span = $emptyStyle,
        message = "This style declaration is empty. Its generated class lets consumers depend on a style name before the element's styles are defined. Define the complete styles with the project's design tokens before you export the class, or remove the declaration and its className use.",
        severity = "error"
    )
}
