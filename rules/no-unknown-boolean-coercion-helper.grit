file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect/atom-react"`
    },
    $body <: contains `typeof $value === "boolean"` as $call,
    $body <: contains `Match.orElse(() => null)`,
    register_diagnostic(
        span = $call,
        message = "Decode boolean input with Schema before using it in service logic. Local type checks spread coercion and optionality policy across operations. Define the boolean's optionality in the schema, decode the input once, and read the typed result in the Effect pipeline. Preserve the input's accepted values and absence semantics.",
        severity = "error"
    )
}
