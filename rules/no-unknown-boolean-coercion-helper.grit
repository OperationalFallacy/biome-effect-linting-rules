file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    $body <: contains `typeof $value === "boolean"` as $call,
    $body <: contains `Match.orElse(() => null)`,
    register_diagnostic(
        span = $call,
        message = "This code checks an unknown value's boolean type inside the service. Repeated local checks can give the same input different meanings across operations. Decode unknown input with a boolean schema, including its optionality, then read the typed boolean in the service.",
        severity = "error"
    )
}
