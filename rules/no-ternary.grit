file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    $body <: contains `$cond ? $then : $else` as $ternary,
    register_diagnostic(
        span = $cond,
        message = "This rule flags ternary expressions to make value selection a distinct step in the operation. Select this value with Match.value, Option.match, or Either.match, then continue the Effect pipeline.",
        severity = "error"
    )
}
