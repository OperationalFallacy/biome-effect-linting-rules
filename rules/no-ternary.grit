file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    $body <: contains `$cond ? $then : $else` as $ternary,
    register_diagnostic(
        span = $cond,
        message = "Replace the ternary with an explicit value-selection step. Embedding the decision in another expression mixes selection with the surrounding operation. Select the value with Match.value, Option.match, or Either.match, then continue the Effect pipeline. Preserve the condition and both outcomes.",
        severity = "error"
    )
}
