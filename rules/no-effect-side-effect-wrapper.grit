language js(typescript, jsx)

or {
    `Effect.as($first, $second)` as $call where {
        or {
            $first <: contains `setState($_)`,
            $first <: contains `Atom.set($_)`,
            $first <: contains `invalidate($_)`,
            $first <: contains `Effect.log$_`,
            $first <: contains `console.$method($_)`
        },
        register_diagnostic(
            span = $call,
            message = "Give the update or log its own step instead of wrapping it in Effect.as. Combining the work with a replacement result obscures the relationship between the operation and its output. Sequence the work with Effect.andThen, Effect.flatMap, or Effect.tap, and produce the required result explicitly.",
            severity = "error"
        )
    },
    `Effect.andThen($first, $second)` as $call where {
        or {
            $first <: contains `setState($_)`,
            $first <: contains `Atom.set($_)`,
            $first <: contains `invalidate($_)`,
            $first <: contains `Effect.log$_`,
            $first <: contains `console.$method($_)`
        },
        register_diagnostic(
            span = $call,
            message = "Put the update or log in an explicit pipeline step. Nesting it inside a data-first Effect.andThen makes its role harder to follow. Start the pipeline with that operation and use Effect.andThen, Effect.flatMap, or Effect.tap to continue, preserving the result the caller needs.",
            severity = "error"
        )
    }
}
