language js(typescript, jsx)

// This rule gives the first action in Effect.andThen its own pipeline step.
// The no-effect-as rule reports result replacement independently of that action.
`Effect.andThen($first, $second)` as $call where {
  $first <: inline_side_effect(),
  register_diagnostic(span=$call, message="This preset requires an inline update or log to occupy its own pipeline step. Start the pipeline with that action and use Effect.andThen or Effect.flatMap to continue. Preserve its deferred execution, failure behavior, and the result the caller needs.", severity="error")
}

// An inline side effect is the input operation itself. A log inside a nested
// callback does not make the enclosing operation a side-effect wrapper.
pattern inline_side_effect() {
  or {
    native_update(),
    JsCallExpression(callee=`Effect.log$_`),
    `Effect.sync($fn)` where {
      $fn <: JsArrowFunctionExpression(body=native_update())
    }
  }
}

pattern native_update() {
  or {
    `setState($_)`,
    `Atom.set($_)`,
    `invalidate($_)`,
    `console.$method($_)`
  }
}
