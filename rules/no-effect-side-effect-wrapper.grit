language js(typescript, jsx)

or {
    `Effect.as($first, $second)` as $call where {
        or {
            $first <: contains `setState($_)`,
            $first <: contains `Atom.set($_)`,
            $first <: contains `invalidate($_)`,
            $first <: contains `Effect.log$_`,
            $first <: contains `console.$method($_)`
        },
        register_diagnostic(
            span = $call,
            message = "This Effect.as combines a side effect with a replacement result, which makes the side effect harder to identify as a step of its own. Replace Effect.as around this side effect with an explicit Effect.andThen, Effect.flatMap, or Effect.tap step, and preserve the result the caller needs.",
            severity = "error"
        )
    },
    `Effect.zipRight($first, $second)` as $call where {
        or {
            $first <: contains `setState($_)`,
            $first <: contains `Atom.set($_)`,
            $first <: contains `invalidate($_)`,
            $first <: contains `Effect.log$_`,
            $first <: contains `console.$method($_)`
        },
        register_diagnostic(
            span = $call,
            message = "This Effect.zipRight sequences a side effect and discards its result. This rule requires that work to appear as an explicit pipeline step. Replace Effect.zipRight around this side effect with an explicit Effect.andThen, Effect.flatMap, or Effect.tap step, and preserve the result the caller needs.",
            severity = "error"
        )
    }
}
