language js(typescript, jsx)

or {
    `try { $tryBlock } catch ($err) { $catchBlock }` as $try,
    `try { $tryBlock } catch { $catchBlock }` as $try,
    `try { $tryBlock } catch ($err) { $catchBlock } finally { $finallyBlock }` as $try,
    `try { $tryBlock } catch { $catchBlock } finally { $finallyBlock }` as $try
} where {
    register_diagnostic(
        span = $try,
        message = "Represent recoverable failures in the Effect error type instead of a try/catch block. Thrown-exception handling separates those failures from the operation's typed errors. Handle them through Effect error combinators in the pipeline and preserve the original recovery behavior. Keep resource cleanup attached to the operation.",
        severity = "error"
    )
}
