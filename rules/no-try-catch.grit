language js(typescript, jsx)

or {
    `try { $tryBlock } catch ($err) { $catchBlock }` as $try,
    `try { $tryBlock } catch { $catchBlock }` as $try,
    `try { $tryBlock } catch ($err) { $catchBlock } finally { $finallyBlock }` as $try,
    `try { $tryBlock } catch { $catchBlock } finally { $finallyBlock }` as $try
} where {
    register_diagnostic(
        span = $try,
        message = "A try/catch block handles thrown exceptions separately from the Effect's typed failures. This rule requires failures to be part of the Effect operation. Represent the failure in the Effect error type and handle it with Effect error combinators.",
        severity = "error"
    )
}
