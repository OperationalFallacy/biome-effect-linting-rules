language js(typescript, jsx)

or {
    `Effect.sync($callback)`,
    `Effect.sync<$types>($callback)`
} where {
    or {
        $callback <: `() => { $statements }` where {
            $statements <: [..., `return $operation`, ...]
        },
        $callback <: `() => $operation`
    },
    or {
        $operation <: `Atom.$method($args)` as $atomCall,
        $operation <: `Atom.$method<$types>($args)` as $atomCall
    },
    $method <: or { `get`, `set`, `update`, `modify`, `refresh` },
    register_diagnostic(
        span = $atomCall,
        message = "Use the Atom operation directly in the Effect sequence. Atom.get, set, update, modify, and refresh already return Effects. Effect.sync returns that Effect as a value and leaves the atom operation unexecuted. Yield the Atom operation or compose it with flatMap or andThen. Keep Effect.sync around synchronous registry instance methods such as atomRegistry.get or atomRegistry.set.",
        severity = "error"
    )
}
