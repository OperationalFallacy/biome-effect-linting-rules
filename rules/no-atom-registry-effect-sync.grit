// Flags Effect.sync wrappers around atomRegistry/Atom operations; use Atom conversions directly.
file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    or {
        $body <: contains bubble `Effect.sync($fn)` where {
            or {
                $fn <: contains `atomRegistry.$method($args)` as $atomCall,
                $fn <: contains `Atom.$method($args)` as $atomCall,
                $fn <: contains `Atom.$method<$types>($args)` as $atomCall
            },
            or {
                $method <: `get`,
                $method <: `set`,
                $method <: `update`,
                $method <: `modify`,
                $method <: `refresh`
            },
            register_diagnostic(
                span = $atomCall,
                message = "This Effect.sync wraps an Atom or atomRegistry operation in another callback. This rule keeps atom reads and updates explicit through the atom API. Call the appropriate get, set, update, modify, or refresh operation directly and remove the Effect.sync wrapper.",
                severity = "error"
            )
        },
        $body <: contains bubble `Effect.sync<$types>($fn)` where {
            or {
                $fn <: contains `atomRegistry.$method($args)` as $atomCall,
                $fn <: contains `Atom.$method($args)` as $atomCall,
                $fn <: contains `Atom.$method<$types>($args)` as $atomCall
            },
            or {
                $method <: `get`,
                $method <: `set`,
                $method <: `update`,
                $method <: `modify`,
                $method <: `refresh`
            },
            register_diagnostic(
                span = $atomCall,
                message = "This Effect.sync wraps an Atom or atomRegistry operation in another callback. This rule keeps atom reads and updates explicit through the atom API. Call the appropriate get, set, update, modify, or refresh operation directly and remove the Effect.sync wrapper.",
                severity = "error"
            )
        }
    }
}
