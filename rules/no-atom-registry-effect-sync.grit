// Flags Effect.sync wrappers around atomRegistry/Atom operations; use Atom conversions directly.
file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect/atom-react"`
    },
    or {
        $body <: contains bubble `Effect.sync($fn)` where {
            or {
                $fn <: contains `atomRegistry.$method($args)` as $atomCall,
                $fn <: contains `Atom.$method($args)` as $atomCall,
                $fn <: contains `Atom.$method<$types>($args)` as $atomCall
            },
            or {
                $method <: `get`,
                $method <: `set`,
                $method <: `update`,
                $method <: `modify`,
                $method <: `refresh`
            },
            register_diagnostic(
                span = $atomCall,
                message = "Call atom operations directly through the atom API. Effect.sync adds a callback around the read or update and obscures the atom operation. Use get, set, update, modify, or refresh directly. Keep the read or update at the same point in the operation and preserve its result.",
                severity = "error"
            )
        },
        $body <: contains bubble `Effect.sync<$types>($fn)` where {
            or {
                $fn <: contains `atomRegistry.$method($args)` as $atomCall,
                $fn <: contains `Atom.$method($args)` as $atomCall,
                $fn <: contains `Atom.$method<$types>($args)` as $atomCall
            },
            or {
                $method <: `get`,
                $method <: `set`,
                $method <: `update`,
                $method <: `modify`,
                $method <: `refresh`
            },
            register_diagnostic(
                span = $atomCall,
                message = "Call atom operations directly through the atom API. Effect.sync adds a callback around the read or update and obscures the atom operation. Use get, set, update, modify, or refresh directly. Keep the read or update at the same point in the operation and preserve its result.",
                severity = "error"
            )
        }
    }
}
