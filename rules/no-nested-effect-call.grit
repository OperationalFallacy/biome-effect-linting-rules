file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect/atom-react"`
    },
    $body <: contains bubble `Effect.$outer($first)` as $outerCall where {
        or {
            $first <: `Effect.$inner($innerOnly)` where {
                $innerOnly <: `Effect.$deep($_)`
            },
            $first <: `Effect.$inner($innerFirst, $innerSecond)` where {
                $innerFirst <: `Effect.$deep($_)`
            }
        },
        register_diagnostic(
            span = $outerCall,
            message = "Put nested Effect calls into one pipeline in execution order. Several levels of nesting make the reader reconstruct the sequence from the inside out. Compute the required inputs first, then connect the dependent Effect steps in the same pipeline.",
            severity = "error"
        )
    },
    $body <: contains bubble `Effect.$outer($first, $second)` as $outerCall where {
        or {
            $first <: `Effect.$inner($innerOnly)` where {
                $innerOnly <: `Effect.$deep($_)`
            },
            $first <: `Effect.$inner($innerFirst, $innerSecond)` where {
                $innerFirst <: `Effect.$deep($_)`
            }
        },
        register_diagnostic(
            span = $outerCall,
            message = "Put nested Effect calls into one pipeline in execution order. Several levels of nesting make the reader reconstruct the sequence from the inside out. Compute the required inputs first, then connect the dependent Effect steps in the same pipeline.",
            severity = "error"
        )
    }
}
