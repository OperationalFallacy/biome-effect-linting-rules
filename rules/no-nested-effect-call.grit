file($body) where {
    $body <: contains bubble JsModuleSource() as $moduleSource where {
        $moduleSource <: r".(?:effect(?:/.*)?|@effect/atom-react)."
    },
    $body <: contains bubble JsCallExpression(callee = `Effect.$outer`, arguments = JsCallArguments(args = [$first, ...])) as $call where {
        $first <: JsCallExpression(callee = `Effect.$inner`, arguments = JsCallArguments(args = [$deep, ...])),
        $deep <: JsCallExpression(callee = `Effect.$method`),
        $outer <: not or { `runPromise`, `runPromiseWith`, `runPromiseExit`, `runPromiseExitWith`, `runSync`, `runSyncWith`, `runSyncExit`, `runSyncExitWith`, `runFork`, `runForkWith` },
        register_diagnostic(
            span = $call,
            message = "Put nested Effect calls into one pipeline in execution order. The reader must work from the inner call outward to reconstruct the sequence. Compute the required inputs first, then connect the dependent Effect steps in the same pipeline.",
            severity = "error"
        )
    }
}
