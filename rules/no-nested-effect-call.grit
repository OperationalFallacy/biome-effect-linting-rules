language js(typescript, jsx)

// The no-nested-effect-call rule reports a chain of dependent Effect calls at
// the outer call itself when it is not a declaration or return value. The
// ladder rule reports statement values. Callback operations receive their own
// checks even inside valid conditions, resource scopes, or runners.
JsCallExpression(callee=`Effect.$outer`, arguments=JsCallArguments(args=[
  $first, ...
])) as $call where {
  $first <: effect_input_call(),
  $call <: within effect_module(),
  not direct_effect_input(call=$call),
  not inside_dependent_chain(call=$call),
  not statement_value(call=$call),
  register_diagnostic(span=$call, message="This preset requires dependent Effect calls in one pipeline. Nested arguments hide the input and make the reader reconstruct the sequence. Start with the input Effect and apply the dependent steps in execution order.", severity="error")
}

// The effect_input_call pattern identifies an Effect call whose first
// argument is another Effect call. Callback bodies and later arguments do not
// establish this dependency chain.
pattern effect_input_call() {
  JsCallExpression(callee=`Effect.$method`, arguments=JsCallArguments(args=[
    JsCallExpression(callee=`Effect.$input`), ...
  ]))
}

// The effect_module pattern limits this syntactic rule to modules with an
// Effect-related dependency. It checks module sources rather than arbitrary
// strings and does not resolve aliases or prove the identity of a binding.
pattern effect_module() {
  JsModule() as $module where {
    $module <: contains JsModuleSource() as $source where {
      $source <: r".(?:effect(?:/.*)?|@effect/atom-react)."
    }
  }
}

// The direct_effect_input predicate keeps an operation's definition, condition,
// resource lifetime, or execution together with its input, as Effect v4 permits.
// The exemption applies to the matched call. It grants no exemption to an
// enclosing function or callback. Context-provided runners take their context
// before a separate curried invocation and do not belong in this list.
predicate direct_effect_input($call) {
  $call <: JsCallExpression(callee=`Effect.$method`),
  $method <: or {
    `fn`,
    `fnUntraced`,
    `fnUntracedEager`,
    `when`,
    `acquireRelease`,
    `acquireUseRelease`,
    `scoped`,
    `ensuring`,
    `runSync`,
    `runSyncExit`,
    `runPromise`,
    `runPromiseExit`,
    `runFork`
  }
}

// A dependent_chain contains at least three Effect calls along first arguments.
// Calls that define operations, conditions, resource lifetimes, or runners stay valid.
pattern dependent_chain() {
  JsCallExpression(callee=`Effect.$method`, arguments=JsCallArguments(args=[
    $first, ...
  ])) as $chain where {
    $first <: effect_input_call(),
    not direct_effect_input(call=$chain)
  }
}

// Only the outer call of one dependent chain receives a diagnostic. Searches
// stop at function bodies and arrows so callbacks and methods retain their checks.
predicate inside_dependent_chain($call) {
  $call <: within dependent_chain() as $chain where {
    $chain <: not $call,
    $chain <: JsCallExpression(arguments=JsCallArguments(args=[$first, ...])),
    $first <: contains $call until or {
      JsFunctionBody(),
      JsFunctionExpression(),
      JsArrowFunctionExpression()
    }
  } until or {
    JsFunctionBody(),
    JsFunctionExpression(),
    JsArrowFunctionExpression()
  }
}

// The ladder rule reports a complete declaration or return for these calls.
// A call inside a callback does not become the value of an enclosing statement.
predicate statement_value($call) {
  $call <: within or {
    `const $name = $call;`,
    `const $name: $type = $call;`,
    JsReturnStatement(argument=$call),
    JsReturnStatement(argument=JsYieldExpression(argument=JsYieldArgument(expression=$call)))
  }
}
