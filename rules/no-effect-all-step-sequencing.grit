language js(typescript, jsx)

or {
    `Effect.all($steps, $options)` as $call where {
        $options <: contains `concurrency: 1`,
        or {
            $steps <: contains `Ref.set($_, $_)`,
            $steps <: contains `Atom.set($_, $_)`,
            $steps <: contains `SubscriptionRef.set($_, $_)`,
            $steps <: contains `Reactivity.invalidate($_)`,
            $steps <: contains `Fiber.interrupt($_)`,
            $steps <: contains `Effect.log$_`
        }
    },
    `Effect.all($steps).pipe(Effect.asVoid)` as $call where {
        or {
            $steps <: contains `Ref.set($_, $_)`,
            $steps <: contains `Atom.set($_, $_)`,
            $steps <: contains `SubscriptionRef.set($_, $_)`,
            $steps <: contains `Reactivity.invalidate($_)`,
            $steps <: contains `Fiber.interrupt($_)`,
            $steps <: contains `Effect.log$_`
        }
    }
} where {
    register_diagnostic(
        span = $call,
        message = "Sequence these Effect operations with Effect.andThen or Effect.flatMap. Effect.all treats consecutive steps as collection entries, so its options determine their execution order. Keep the steps in one pipeline and preserve their order and failure behavior. Reserve Effect.all for operations that collect results.",
        severity = "error"
    )
}
