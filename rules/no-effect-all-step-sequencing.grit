language js(typescript, jsx)

or {
    `Effect.all($steps, $options)` as $call where {
        $options <: contains `concurrency: 1`,
        or {
            $steps <: contains `Ref.set($_, $_)`,
            $steps <: contains `Atom.set($_, $_)`,
            $steps <: contains `SubscriptionRef.set($_, $_)`,
            $steps <: contains `Reactivity.invalidate($_)`,
            $steps <: contains `Fiber.interrupt($_)`,
            $steps <: contains `Effect.log$_`
        }
    },
    `Effect.all($steps).pipe(Effect.asVoid)` as $call where {
        or {
            $steps <: contains `Ref.set($_, $_)`,
            $steps <: contains `Atom.set($_, $_)`,
            $steps <: contains `SubscriptionRef.set($_, $_)`,
            $steps <: contains `Reactivity.invalidate($_)`,
            $steps <: contains `Fiber.interrupt($_)`,
            $steps <: contains `Effect.log$_`
        }
    }
} where {
    register_diagnostic(
        span = $call,
        message = "Sequence these Effect operations with Effect.andThen or Effect.flatMap. Using Effect.all for consecutive steps makes their order depend on collection options. Keep the steps in execution order in one pipeline and preserve their failure behavior. Reserve Effect.all for collecting results.",
        severity = "error"
    )
}
