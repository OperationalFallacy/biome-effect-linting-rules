language js(typescript, jsx)

or {
    `Effect.all($steps, $options)` as $call where {
        $options <: contains `concurrency: 1`,
        or {
            $steps <: contains `Ref.set($_, $_)`,
            $steps <: contains `Atom.set($_, $_)`,
            $steps <: contains `SubscriptionRef.set($_, $_)`,
            $steps <: contains `Reactivity.invalidate($_)`,
            $steps <: contains `Fiber.interrupt($_)`,
            $steps <: contains `Effect.log$_`
        }
    },
    `Effect.all($steps).pipe(Effect.asVoid)` as $call where {
        or {
            $steps <: contains `Ref.set($_, $_)`,
            $steps <: contains `Atom.set($_, $_)`,
            $steps <: contains `SubscriptionRef.set($_, $_)`,
            $steps <: contains `Reactivity.invalidate($_)`,
            $steps <: contains `Fiber.interrupt($_)`,
            $steps <: contains `Effect.log$_`
        }
    }
} where {
    register_diagnostic(
        span = $call,
        message = "This Effect.all uses an array to describe consecutive side effects, which makes their execution order depend on the collection options. Sequence these side effects with Effect.andThen or Effect.flatMap. Use Effect.all when the operation collects results.",
        severity = "error"
    )
}
