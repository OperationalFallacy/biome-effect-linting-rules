language js(typescript, jsx)

or {
    `Ref.update($ref, ($state) => ({ $props }))` as $violation where {
        $props <: contains `...$_`
    },
    `Ref.update($ref, ($state) => { $block })` as $violation where {
        $block <: contains `return { $props }`,
        $props <: contains `...$_`
    },
    `Ref.modify($ref, ($state) => ({ $props }))` as $violation where {
        $props <: contains `...$_`
    },
    `Ref.modify($ref, ($state) => { $block })` as $violation where {
        $block <: contains `return { $props }`,
        $props <: contains `...$_`
    },
    `Object.fromEntries($entries)` as $violation where {
        $entries <: contains `Object.entries($_)`
    },
    `Object.assign({}, $_, $_)` as $violation,
    `JSON.stringify($_)` as $violation,
    `JSON.parse($_)` as $violation
} where {
    register_diagnostic(
        span = $violation,
        message = "This rule flags object copies, record rebuilds, and raw JSON operations in state transitions because they can separate field updates from the model's validation and construction rules. Update state with Record.set, Record.modify, or Record.remove inside Struct.evolve. Reconstruct models with their schema constructors, such as Schema.make or a field's make method. Encode and decode serialized data through Schema where it enters or leaves the application. Consult docs/linting.md for the full procedure.",
        severity = "error"
    )
}
