language js(typescript, jsx)

or {
    `Ref.update($ref, ($state) => ({ $props }))` as $violation where {
        $props <: contains `...$_`
    },
    `Ref.update($ref, ($state) => { $block })` as $violation where {
        $block <: contains `return { $props }`,
        $props <: contains `...$_`
    },
    `Ref.modify($ref, ($state) => ({ $props }))` as $violation where {
        $props <: contains `...$_`
    },
    `Ref.modify($ref, ($state) => { $block })` as $violation where {
        $block <: contains `return { $props }`,
        $props <: contains `...$_`
    },
    `Object.fromEntries($entries)` as $violation where {
        $entries <: contains `Object.entries($_)`
    },
    `Object.assign({}, $_, $_)` as $violation,
    `JSON.stringify($_)` as $violation,
    `JSON.parse($_)` as $violation
} where {
    register_diagnostic(
        span = $violation,
        message = "Update state through its model and field operations instead of raw object copies or record rebuilds. Raw copies separate field changes from the model's construction and validation rules. Use Record.set, Record.modify, or Record.remove inside Struct.evolve, and reconstruct models with their schema constructors, such as Schema.make or a field's make method. Use Schema to encode and decode serialized data instead of raw JSON calls. Follow docs/linting.md for the full procedure.",
        severity = "error"
    )
}
