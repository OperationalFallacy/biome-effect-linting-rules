language js(typescript, jsx)

// The assertion matcher backports Biome 2.6.6's noUnsafeTypeAssertion rule.
// This Grit backport supplies Effect Schema guidance through packaged presets
// and the WASM CLI. Biome's built-in rule has a fixed diagnostic message.
// Upstream source:
// https://github.com/biomejs/biome/blob/09ee04dfb99b41a06186fee366c0a6b388b13f75/crates/biome_js_analyze/src/lint/nursery/no_unsafe_type_assertion.rs
// Copyright (c) 2023-present Biome Developers and Contributors.
// Copyright (c) 2020-2023 Rome Tools is Rome Tools, Inc. and its affiliates.
// The port uses the upstream MIT license; its permission terms are in LICENSE.
//
// Biome's matcher covers as expressions, angle-bracket assertions, and both
// assignment forms. This port retains those checks and restricts them to
// Effect modules.
//
// The Effect diagnostic requires Schema decoding because assertions supply
// model types without executing validation. It tells callers to use the
// decoded result and preserve decoding failures in their Effect composition.
// Grit checks assertion syntax within one file; Schema executes validation.
// The diagnostic covers the whole assertion so the input and type remain visible.
or {
  TsAsExpression(ty=$assertedType),
  TsAsAssignment(ty=$assertedType),
  TsTypeAssertionExpression(ty=$assertedType),
  TsTypeAssertionAssignment(ty=$assertedType)
} as $assertion where {
  $assertedType <: not const_assertion_type(),
  $assertion <: within JsModule() as $body,
  $body <: contains bubble JsModuleSource() as $moduleSource where {
    $moduleSource <: r"^.(?:effect(?:/.*)?|@effect/atom-react).$"
  },
  register_diagnostic(span=$assertion, message="This type assertion supplies a type without validating the value. Decode unknown input with Schema.decodeUnknownEffect, use Schema.fromJsonString for JSON text, and continue with the decoded value. Construct trusted model values with their schema constructors. Preserve decoding failures in the Effect.", severity="error")
}

// The const_assertion_type pattern preserves literal inference through Biome's
// exception for an unqualified const reference without type arguments.
pattern const_assertion_type() {
  TsReferenceType(name=r"^const$") as $constType where {
    $constType <: not TsReferenceType(type_arguments=TsTypeArguments())
  }
}
