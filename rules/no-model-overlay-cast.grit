file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    $body <: contains `const $castName = $value as $type` as $call,
    $call <: not `const $_ = $_ as const`,
    register_diagnostic(
        span = $call,
        message = "This type assertion tells TypeScript to trust a model shape, which can conceal a mismatch between the value and its schema. Decode this value with the required Schema and read the decoded fields.",
        severity = "error"
    )
}
