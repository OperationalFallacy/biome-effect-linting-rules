language js(typescript, jsx)

// This rule reports mutable declarations and direct state writes. Matching AST
// nodes keeps ordinary field names and text from being mistaken for mutations.
or {
  JsVariableDeclaration() as $declaration where {
    $declaration <: r"(?s)(?:let|var)\s.*"
  },
  JsAssignmentExpression(),
  JsPreUpdateExpression(),
  JsPostUpdateExpression(),
  JsUnaryExpression() as $deletion where { $deletion <: r"(?s)delete\b.*" }
} as $violation where {
  register_diagnostic(span=$violation, message="This preset requires immutable values or Effect state operations instead of variable reassignment and direct mutation. Return the next state explicitly so callers can follow the transition.", severity="error")
}
