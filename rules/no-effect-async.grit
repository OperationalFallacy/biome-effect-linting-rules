file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect/atom-react"`
    },
    or {
        $body <: contains `Effect.async($args)` as $async,
        $body <: contains `Effect.async<$types>($args)` as $async
    },
    register_diagnostic(
        span = $async,
        message = "Replace Effect.async with Effect.callback. Effect v4 renamed the callback constructor. Keep registration inside the callback and return its cleanup Effect to release resources on interruption. Use Stream for a sequence of events and acquire/release for resource lifetimes.",
        severity = "error"
    )
}
