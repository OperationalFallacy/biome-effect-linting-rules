language js(typescript, jsx)

JsCallExpression(callee = `Effect.async`) as $async where {
    $async <: within JsModule() as $body,
    $body <: contains bubble JsModuleSource() as $moduleSource where {
        $moduleSource <: r".(?:effect(?:/.*)?|@effect/atom-react)."
    },
    register_diagnostic(
        span = $async,
        message = "Replace Effect.async with Effect.callback. Effect.callback registers asynchronous work and resumes the operation through a callback. Keep registration inside the callback and return its cleanup Effect to release resources on interruption. Use Stream for a sequence of events and acquire/release for resource lifetimes.",
        severity = "error"
    )
}
