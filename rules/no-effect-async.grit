file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    or {
        $body <: contains `Effect.async($args)` as $async,
        $body <: contains `Effect.async<$types>($args)` as $async
    },
    register_diagnostic(
        span = $async,
        message = "This rule flags Effect.async to make resource setup, use, and cleanup explicit in the operation. Callback registration can separate those responsibilities across several functions. Use Stream for a sequence of events, or an acquire/use/release operation for a resource with a defined lifetime.",
        severity = "error"
    )
}
