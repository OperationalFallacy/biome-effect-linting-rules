file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    or {
        $body <: contains `Effect.async($args)` as $async,
        $body <: contains `Effect.async<$types>($args)` as $async
    },
    register_diagnostic(
        span = $async,
        message = "Replace Effect.async with a managed callback integration. Callback registration requires cancellation and cleanup to remain connected to setup. Use Stream for event sequences or an acquire/use/release operation for a resource. Keep registration, interruption handling, and cleanup in that managed lifetime.",
        severity = "error"
    )
}
