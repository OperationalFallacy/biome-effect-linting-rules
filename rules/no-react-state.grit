or {
    `$fn($args)` where {
        or {
            $fn <: `useState`,
            $fn <: `useReducer`,
            $fn <: `useContext`,
            $fn <: `useCallback`,
            $fn <: `useEffect`,
            $fn <: `useSyncExternalStore`
        },
        register_diagnostic(
            span = $fn,
            message = "Use @effect-atom/atom-react for state and subscriptions instead of the React hooks flagged here. This preset uses the atom runtime to keep state, context, callbacks, effects, and subscriptions in one application model. Move canonical state changes into Effect services and expose reads and commands through atoms.",
            severity = "error"
        )
    },
    `$fn<$types>($args)` where {
        or {
            $fn <: `useState`,
            $fn <: `useReducer`,
            $fn <: `useContext`,
            $fn <: `useCallback`,
            $fn <: `useEffect`,
            $fn <: `useSyncExternalStore`
        },
        register_diagnostic(
            span = $fn,
            message = "Use @effect-atom/atom-react for state and subscriptions instead of the React hooks flagged here. This preset uses the atom runtime to keep state, context, callbacks, effects, and subscriptions in one application model. Move canonical state changes into Effect services and expose reads and commands through atoms.",
            severity = "error"
        )
    },
    `$receiver.$fn($args)` where {
        or {
            $fn <: `useState`,
            $fn <: `useReducer`,
            $fn <: `useContext`,
            $fn <: `useCallback`,
            $fn <: `useEffect`,
            $fn <: `useSyncExternalStore`
        },
        register_diagnostic(
            span = $fn,
            message = "Use @effect-atom/atom-react for state and subscriptions instead of the React hooks flagged here. This preset uses the atom runtime to keep state, context, callbacks, effects, and subscriptions in one application model. Move canonical state changes into Effect services and expose reads and commands through atoms.",
            severity = "error"
        )
    },
    `$receiver.$fn<$types>($args)` where {
        or {
            $fn <: `useState`,
            $fn <: `useReducer`,
            $fn <: `useContext`,
            $fn <: `useCallback`,
            $fn <: `useEffect`,
            $fn <: `useSyncExternalStore`
        },
        register_diagnostic(
            span = $fn,
            message = "Use @effect-atom/atom-react for state and subscriptions instead of the React hooks flagged here. This preset uses the atom runtime to keep state, context, callbacks, effects, and subscriptions in one application model. Move canonical state changes into Effect services and expose reads and commands through atoms.",
            severity = "error"
        )
    }
}
