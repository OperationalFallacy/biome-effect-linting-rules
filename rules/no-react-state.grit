or {
    `$fn($args)` where {
        or {
            $fn <: `useState`,
            $fn <: `useReducer`,
            $fn <: `useContext`,
            $fn <: `useCallback`,
            $fn <: `useEffect`,
            $fn <: `useSyncExternalStore`
        },
        register_diagnostic(
            span = $fn,
            message = "This rule flags React hooks for state, context, callbacks, effects, and subscriptions because this preset uses the atom runtime for that work. Manage state and subscriptions with @effect-atom/atom-react so those operations share the application's atom model.",
            severity = "error"
        )
    },
    `$fn<$types>($args)` where {
        or {
            $fn <: `useState`,
            $fn <: `useReducer`,
            $fn <: `useContext`,
            $fn <: `useCallback`,
            $fn <: `useEffect`,
            $fn <: `useSyncExternalStore`
        },
        register_diagnostic(
            span = $fn,
            message = "This rule flags React hooks for state, context, callbacks, effects, and subscriptions because this preset uses the atom runtime for that work. Manage state and subscriptions with @effect-atom/atom-react so those operations share the application's atom model.",
            severity = "error"
        )
    },
    `$receiver.$fn($args)` where {
        or {
            $fn <: `useState`,
            $fn <: `useReducer`,
            $fn <: `useContext`,
            $fn <: `useCallback`,
            $fn <: `useEffect`,
            $fn <: `useSyncExternalStore`
        },
        register_diagnostic(
            span = $fn,
            message = "This rule flags React hooks for state, context, callbacks, effects, and subscriptions because this preset uses the atom runtime for that work. Manage state and subscriptions with @effect-atom/atom-react so those operations share the application's atom model.",
            severity = "error"
        )
    },
    `$receiver.$fn<$types>($args)` where {
        or {
            $fn <: `useState`,
            $fn <: `useReducer`,
            $fn <: `useContext`,
            $fn <: `useCallback`,
            $fn <: `useEffect`,
            $fn <: `useSyncExternalStore`
        },
        register_diagnostic(
            span = $fn,
            message = "This rule flags React hooks for state, context, callbacks, effects, and subscriptions because this preset uses the atom runtime for that work. Manage state and subscriptions with @effect-atom/atom-react so those operations share the application's atom model.",
            severity = "error"
        )
    }
}
