file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    $body <: contains `Runtime.runFork($args)` as $runFork,
    register_diagnostic(
        span = $runFork,
        message = "Give background work a managed lifetime instead of starting it with Runtime.runFork. Runtime.runFork leaves cancellation and cleanup to the caller. Use forkScoped, Stream, or the application runtime to tie the work to a defined lifetime and preserve resource cleanup.",
        severity = "error"
    )
}
