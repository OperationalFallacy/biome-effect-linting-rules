file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    $body <: contains `Runtime.runFork($args)` as $runFork,
    register_diagnostic(
        span = $runFork,
        message = "Runtime.runFork starts a fiber whose lifetime must be managed by the caller. This rule requires background work to have an explicit owner for cancellation and cleanup. Use forkScoped, Stream, or the application runtime to give this work a managed lifetime.",
        severity = "error"
    )
}
