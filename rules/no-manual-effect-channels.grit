language js(typescript, jsx)

or {
    `Effect.Effect<$channels>` as $match,
    `Layer.Layer<$channels>` as $match
} where {
    register_diagnostic(
        span = $match,
        message = "Let TypeScript infer the Effect or Layer type from the composed operation. Manual result, error, and dependency annotations duplicate a contract that the operation already defines. Remove the explicit Effect.Effect or Layer.Layer annotation and return the operation directly. Expose a service method for a named domain contract.",
        severity = "error"
    )
}
