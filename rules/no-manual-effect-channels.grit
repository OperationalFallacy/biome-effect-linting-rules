language js(typescript, jsx)

or {
    `Effect.Effect<$channels>` as $match,
    `Layer.Layer<$channels>` as $match
} where {
    register_diagnostic(
        span = $match,
        message = "Let TypeScript infer the Effect or Layer type from the composed operation. Manually repeating result, error, and dependency types creates a separate contract to maintain as the flow changes. Remove the explicit Effect.Effect or Layer.Layer annotation and return the operation directly. Expose a service method for a named domain contract.",
        severity = "error"
    )
}
