language js(typescript, jsx)

or {
    `Effect.Effect<$channels>` as $match,
    `Layer.Layer<$channels>` as $match
} where {
    register_diagnostic(
        span = $match,
        message = "This rule flags explicit Effect or Layer type arguments because the declared result, error, and dependency types can drift from the composed operation. Let TypeScript infer those types from the Effect or Layer you return, or expose a service method that returns the operation directly.",
        severity = "error"
    )
}
