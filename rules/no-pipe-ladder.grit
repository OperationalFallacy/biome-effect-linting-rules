language js(typescript, jsx)

or {
    `pipe($args)`,
    `$target.pipe($args)`
} where {
    or {
        $args <: contains `pipe($_)` as $nested,
        $args <: contains `$inner.pipe($_)` as $nested
    },
    register_diagnostic(
        span = $nested,
        message = "Combine nested pipe calls into one pipeline. Splitting the sequence across nested expressions makes the operation's execution order harder to follow. Keep the steps in order and make the value decision once.",
        severity = "error"
    )
}
