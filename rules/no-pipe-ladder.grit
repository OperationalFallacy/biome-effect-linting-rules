language js(typescript, jsx)

or {
    `pipe($input, $steps)`,
    `$input.pipe($steps)`
} where {
    $input <: or {
        `pipe($innerArgs)`,
        `$target.pipe($innerArgs)`
    } as $nested,
    register_diagnostic(
        span = $nested,
        message = "Combine directly chained pipe calls into one pipeline. The output of the inner pipeline is the input of the outer pipeline, so keep those steps together in execution order. Pipelines inside callbacks can compute separate values and do not need to merge with the enclosing pipeline.",
        severity = "error"
    )
}
