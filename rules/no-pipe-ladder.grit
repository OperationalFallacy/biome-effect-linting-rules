language js(typescript, jsx)

or {
    `pipe($args)`,
    `$target.pipe($args)`
} where {
    or {
        $args <: contains `pipe($_)` as $nested,
        $args <: contains `$inner.pipe($_)` as $nested
    },
    register_diagnostic(
        span = $nested,
        message = "These nested pipe calls split the sequence across several expressions. Combine them into one pipeline so the reader can follow the steps in execution order, with the decision in one place.",
        severity = "error"
    )
}
