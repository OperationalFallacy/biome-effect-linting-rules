language js(typescript, jsx)

or {
    `pipe($args)`,
    `$target.pipe($args)`
} where {
    or {
        $args <: contains `pipe($_)` as $nested until JsFunctionExpression(),
        $args <: contains `$inner.pipe($_)` as $nested until JsFunctionExpression()
    },
    register_diagnostic(
        span = $nested,
        message = "Combine nested pipe calls into one pipeline. The reader must reconstruct execution order across the nested expressions. Keep the steps in order and make the value decision once.",
        severity = "error"
    )
}
