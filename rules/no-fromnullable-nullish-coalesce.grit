file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    or {
        $body <: contains `Option.fromNullable($value ?? null)` as $call,
        $body <: contains `Option.fromNullable($value ?? undefined)` as $call
    },
    register_diagnostic(
        span = $call,
        message = "The nullish fallback repeats the absence handling already provided by Option.fromNullable. Pass the source directly to Option.fromNullable; it converts both null and undefined to None.",
        severity = "error"
    )
}
