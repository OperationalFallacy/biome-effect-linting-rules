file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect/atom-react"`
    },
    or {
        $body <: contains `Option.fromNullishOr($value ?? null)` as $call,
        $body <: contains `Option.fromNullishOr($value ?? undefined)` as $call
    },
    register_diagnostic(
        span = $call,
        message = "Remove the nullish fallback passed to Option.fromNullishOr. The function already converts both null and undefined to None, so the fallback repeats its absence handling. Pass the nullable source directly.",
        severity = "error"
    )
}
