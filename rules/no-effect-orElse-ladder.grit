language js(typescript, jsx)

`Effect.orElse($first, $second)` as $call where {
    or {
        $first <: contains `Effect.flatMap($_)`,
        $first <: contains `Effect.zipRight($_)`,
        $first <: contains `Effect.as($_)`,
        $first <: contains `Effect.tap($_)`
    },
    register_diagnostic(
        span = $call,
        message = "Effect.orElse wraps a chain of Effect steps, which separates the recovery code from the sequence it handles. Put the steps in one pipeline and handle the error at its end so the operation and its recovery appear together.",
        severity = "error"
    )
}
