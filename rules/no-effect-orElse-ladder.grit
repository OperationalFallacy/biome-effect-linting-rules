language js(typescript, jsx)

`Effect.orElse($first, $second)` as $call where {
    or {
        $first <: contains `Effect.flatMap($_)`,
        $first <: contains `Effect.zipRight($_)`,
        $first <: contains `Effect.as($_)`,
        $first <: contains `Effect.tap($_)`
    },
    register_diagnostic(
        span = $call,
        message = "Put the Effect sequence and its recovery in one pipeline. Effect.orElse around a nested chain makes the reader inspect the inner operation to determine which failures it handles. Sequence the work first and place recovery at the end, preserving the failures it covers and the result it returns.",
        severity = "error"
    )
}
