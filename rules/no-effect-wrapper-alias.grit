language js(typescript, jsx)

or {
    `const $name = pipe($expr, $rest)` as $call where {
        $expr <: contains `Effect.$fn($_)`,
        register_diagnostic(
            span = $call,
            message = "This constant gives an Effect pipeline another name, so the reader must find its declaration to understand the steps. Inline this Effect alias at its call site, or define a domain function that returns the data produced by a complete operation.",
            severity = "error"
        )
    },
