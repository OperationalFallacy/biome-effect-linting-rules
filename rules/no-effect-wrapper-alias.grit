language js(typescript, jsx)

or {
    `const $name = pipe($expr, $rest)` as $call where {
        $expr <: contains `Effect.$fn($_)`,
        register_diagnostic(
            span = $call,
            message = "Inline this Effect pipeline alias at its use. The extra name makes the reader find another declaration to understand the steps. Extracted domain functions must perform complete operations with clear result contracts. Renaming the same pipeline behind a wrapper does not establish a domain operation.",
            severity = "error"
        )
    },
    `const $name: $type = pipe($expr, $rest)` as $call where {
        $expr <: contains `Effect.$fn($_)`,
        register_diagnostic(
            span = $call,
            message = "Inline this Effect pipeline alias at its use. The extra name makes the reader find another declaration to understand the steps. Extracted domain functions must perform complete operations with clear result contracts. Renaming the same pipeline behind a wrapper does not establish a domain operation.",
            severity = "error"
        )
    },
    `const $name = () => pipe($expr, $rest)` as $call where {
        $expr <: contains `Effect.$fn($_)`,
        register_diagnostic(
            span = $call,
            message = "Inline this Effect pipeline wrapper at its call site. The wrapper makes the reader inspect another function to understand the steps. Extracted domain functions must perform complete operations with clear result contracts. Moving the same fragment into another wrapper preserves the indirection.",
            severity = "error"
        )
    },
    `const $name = ($params) => pipe($expr, $rest)` as $call where {
        $expr <: contains `Effect.$fn($_)`,
        register_diagnostic(
            span = $call,
            message = "Inline this Effect pipeline wrapper at its call site. The wrapper makes the reader inspect another function to understand the steps. Extracted domain functions must perform complete operations with clear result contracts. Moving the same fragment into another wrapper preserves the indirection.",
            severity = "error"
        )
    },
    `const $name: $type = () => pipe($expr, $rest)` as $call where {
        $expr <: contains `Effect.$fn($_)`,
        register_diagnostic(
            span = $call,
            message = "Inline this Effect pipeline wrapper at its call site. The wrapper makes the reader inspect another function to understand the steps. Extracted domain functions must perform complete operations with clear result contracts. Moving the same fragment into another wrapper preserves the indirection.",
            severity = "error"
        )
    },
    `const $name: $type = ($params) => pipe($expr, $rest)` as $call where {
        $expr <: contains `Effect.$fn($_)`,
        register_diagnostic(
            span = $call,
            message = "Inline this Effect pipeline wrapper at its call site. The wrapper makes the reader inspect another function to understand the steps. Extracted domain functions must perform complete operations with clear result contracts. Moving the same fragment into another wrapper preserves the indirection.",
            severity = "error"
        )
    },
    `const $name = () => Effect.$fn($args)` as $call where {
        register_diagnostic(
