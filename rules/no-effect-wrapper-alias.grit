language js(typescript, jsx)

or {
    `const $name = $value;` as $statement,
    `const $name: $type = $value;` as $statement,
    `function $name($params) { return $value; }` as $statement,
    `function $name($params): $type { return $value; }` as $statement
} where {
    or {
        $statement <: JsFunctionDeclaration() where {
            $value <: `Effect.$method($args)`
        },
        $value <: `pipe($source, $steps)` where {
            $source <: `Effect.$method($args)`
        },
        $value <: JsArrowFunctionExpression(body = $operation) where {
            or {
                $operation <: `Effect.$method($args)`,
                $operation <: `pipe($source, $steps)` where {
                    $source <: `Effect.$method($args)`
                }
            }
        }
    },
    $statement <: not within JsFunctionBody(statements = $statements) where {
        $statements <: [..., $statement, ...],
        $statements <: [..., `return { $members }`, ...],
        $members <: [..., or {
            JsShorthandPropertyObjectMember(name = $name),
            JsPropertyObjectMember(value = $name)
        }, ...]
    } until or { JsFunctionBody(), JsBlockStatement() },
    register_diagnostic(
        span = $statement,
        message = "Inline this intermediate Effect wrapper into its operation. The extra declaration makes the reader inspect another name to understand the steps. Define complete reusable operations with Effect.fn or Effect.fnUntraced, or expose them through the service's returned API. Keep intermediate fragments inside each operation. A new wrapper around the same fragment leaves the extra lookup in place.",
        severity = "error"
    )
}
