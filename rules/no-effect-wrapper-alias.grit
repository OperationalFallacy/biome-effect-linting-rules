            message = "Call the Effect operation directly instead of forwarding arguments through this wrapper. The wrapper adds another function to inspect without explaining a complete domain operation. Give an extracted function a complete domain responsibility and a clear result contract.",
            severity = "error"
        )
    },
    `const $name = ($params) => Effect.$fn($args)` as $call where {
        register_diagnostic(
            span = $call,
            message = "Call the Effect operation directly instead of forwarding arguments through this wrapper. The wrapper adds another function to inspect without explaining a complete domain operation. Give an extracted function a complete domain responsibility and a clear result contract.",
            severity = "error"
        )
    },
    `const $name: $type = () => Effect.$fn($args)` as $call where {
        register_diagnostic(
            span = $call,
            message = "Call the Effect operation directly instead of forwarding arguments through this wrapper. The wrapper adds another function to inspect without explaining a complete domain operation. Give an extracted function a complete domain responsibility and a clear result contract.",
            severity = "error"
        )
    },
    `const $name: $type = ($params) => Effect.$fn($args)` as $call where {
