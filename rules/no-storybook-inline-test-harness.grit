language js(typescript, jsx)

file($body) where {
    $body <: contains `"@storybook/nextjs-vite"`,
    or {
        $body <: contains `play: $play` as $inlineHarness,
        $body <: contains `style={{ $properties }}` as $inlineHarness,
        $body <: contains `useArgs($args)` as $inlineHarness,
        $body <: contains `useAtom($args)` as $inlineHarness
    },
    register_diagnostic(
        span = $inlineHarness,
        message = "Rule: keep Storybook stories declarative. Why: play assertions, inline layout objects, and story-local state harnesses test framework plumbing or rebuild presentation around the component. Fix: express a meaningful rendered state through typed args. Move customer-visible behavior to the representation, service, or route test responsible for that outcome.",
        severity = "error"
    )
}
