language js(typescript, jsx)

JsFunctionBody(statements = $statements) as $block where {
    $statements <: contains `const $fragment = pipe($producerArgs)`,
    $statements <: contains `return pipe($fragment, $...)`,
    register_diagnostic(
        span = $block,
        message = "Combine the local pipeline fragment with the returned pipeline. Splitting production and final selection across declarations makes the reader reconstruct the operation. Keep the steps together in execution order. Extracted functions must perform complete domain operations with clear result contracts. Moving the same fragment into a helper preserves the fragmentation.",
        severity = "error"
    )
}
