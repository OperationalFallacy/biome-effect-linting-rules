language js(typescript, jsx)

// The producer and return must be direct statements in the same lexical block.
// Nested functions can reuse a name without sharing a pipeline fragment.
or {
  JsFunctionBody(statements=$statements),
  JsBlockStatement(statements=$statements)
} as $block where {
  $statements <: [
    ..., `const $fragment = pipe($producerArgs);`, ...,
    `return pipe($fragment, $...);`, ...
  ],
  register_diagnostic(span=$block, message="Combine the local pipeline fragment with the returned pipeline. The producer and final selection occupy separate declarations, so the reader must reconstruct the operation. Keep the steps together in execution order. Extracted functions must perform complete domain operations with clear result contracts. A helper around the same fragment preserves the split.", severity="error")
}
