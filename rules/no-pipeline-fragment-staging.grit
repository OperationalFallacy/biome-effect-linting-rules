language js(typescript, jsx)

JsFunctionBody(statements = $statements) as $block where {
    $statements <: contains `const $fragment = pipe($producerArgs)`,
    $statements <: contains `return pipe($fragment, $...)`,
    register_diagnostic(
        span = $block,
        message = "This operation assigns a pipeline to a local constant, then passes it into the returned pipeline. The reader must follow both expressions to understand the final result. Combine the intermediate pipeline and its final selection, or extract a named function that performs the complete domain operation.",
        severity = "error"
    )
}
