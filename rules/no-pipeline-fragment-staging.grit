language js(typescript, jsx)

JsFunctionBody(statements = $statements) as $block where {
    $statements <: contains `const $fragment = pipe($producerArgs)`,
    $statements <: contains `return pipe($fragment, $...)`,
    register_diagnostic(
        span = $block,
        message = "Combine the local pipeline fragment with the returned pipeline. The producer and final selection occupy separate declarations, so the reader must reconstruct the operation. Keep the steps together in execution order. Extracted functions must perform complete domain operations with clear result contracts. A helper around the same fragment preserves the split.",
        severity = "error"
    )
}
