language js(typescript, jsx)

or {
    `Effect.$outer($first)` as $call where {
        $first <: `Effect.$inner($innerArgs)`
    },
    `Effect.$outer($first, $second)` as $call where {
        or {
            $first <: `Effect.$inner($innerArgs)`,
            $second <: `Effect.$inner($innerArgs)`
        }
    }
} where {
    register_diagnostic(
        span = $call,
        message = "Replace nested Effect calls with a pipeline in execution order. Passing one Effect call directly into another makes the reader work through nested arguments to follow the sequence. Start the pipeline with the inner Effect and apply the subsequent steps with pipe, Effect.flatMap, or Effect.andThen.",
        severity = "error"
    )
}
