language js(typescript, jsx)

or {
    `Effect.$outer($first)` as $call where {
        $first <: `Effect.$inner($innerArgs)`
    },
    `Effect.$outer($first, $second)` as $call where {
        or {
            $first <: `Effect.$inner($innerArgs)`,
            $second <: `Effect.$inner($innerArgs)`
        }
    }
} where {
    register_diagnostic(
        span = $call,
        message = "This Effect call takes another Effect call as an argument, so the execution order is harder to read from the expression. Construct the inner Effect first, then express the sequence in one pipeline with pipe, Effect.flatMap, or Effect.andThen.",
        severity = "error"
    )
}
