language js(typescript, jsx)

JsCallExpression(callee = `Effect.$outer`, arguments = JsCallArguments(args = $arguments)) as $call where {
    $arguments <: [..., JsCallExpression(callee = `Effect.$inner`), ...],
    $inner <: not or { `fn`, `fnUntraced`, `fnUntracedEager` },
    $outer <: not or {
        `fn`, `fnUntraced`, `fnUntracedEager`,
        `runSync`, `runSyncWith`, `runSyncExit`, `runSyncExitWith`,
        `runPromise`, `runPromiseWith`, `runPromiseExit`, `runPromiseExitWith`,
        `runFork`, `runForkWith`
    },
    register_diagnostic(
        span = $call,
        message = "Replace nested Effect calls with a pipeline in execution order. A call that takes another Effect call as an argument requires the reader to reconstruct the sequence from nested arguments. Start the pipeline with the inner Effect, then apply the subsequent steps with pipe, Effect.flatMap, or Effect.andThen.",
        severity = "error"
    )
}
