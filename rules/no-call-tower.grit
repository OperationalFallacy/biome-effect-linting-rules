language js(typescript, jsx)

// The no-call-tower rule keeps dependent Effect steps in execution order.
// It reports direct nesting outside longer first-argument chains, which the
// ladder and nested-call rules report once. Complete operation inputs remain valid.
JsCallExpression(callee=`Effect.$outer`, arguments=JsCallArguments(args=$arguments)) as $call where {
  $arguments <: [..., JsCallExpression(callee=`Effect.$inner`), ...],
  $inner <: not effect_function(),
  not direct_effect_input(call=$call),
  not result_or_side_effect_wrapper(call=$call),
  $call <: not dependent_chain(),
  not inside_dependent_chain(call=$call),
  register_diagnostic(span=$call, message="This preset requires dependent Effect steps in a pipeline. Nested Effect arguments make the reader trace the operation from inner calls outward. Start with the input Effect, then use Effect.flatMap or Effect.andThen for dependent work. Keep effectful conditions, resource lifetimes, and finalizers intact.", severity="error")
}

// The effect_function pattern identifies constructors for complete callable
// operations. A constructor used as a callback does not stage another Effect.
pattern effect_function() {
  or {
    `fn`,
    `fnUntraced`,
    `fnUntracedEager`
  }
}

// The direct_effect_input predicate keeps an operation's definition, condition,
// resource lifetime, or execution together with its input, as Effect v4 permits.
// The exemption applies to the matched call. It grants no exemption to an
// enclosing function or callback. Context-provided runners take their context
// before a separate curried invocation and do not belong in this list.
predicate direct_effect_input($call) {
  $call <: JsCallExpression(callee=`Effect.$method`),
  $method <: or {
    `fn`,
    `fnUntraced`,
    `fnUntracedEager`,
    `when`,
    `acquireRelease`,
    `acquireUseRelease`,
    `scoped`,
    `ensuring`,
    `runSync`,
    `runSyncExit`,
    `runPromise`,
    `runPromiseExit`,
    `runFork`
  }
}

// The first argument supplies the result consumed by this Effect call.
pattern effect_input_call() {
  JsCallExpression(callee=`Effect.$method`, arguments=JsCallArguments(args=[
    JsCallExpression(callee=`Effect.$input`), ...
  ]))
}

// A dependent_chain contains at least three Effect calls along first arguments.
// Calls that define operations, conditions, resource lifetimes, or runners stay valid.
pattern dependent_chain() {
  JsCallExpression(callee=`Effect.$method`, arguments=JsCallArguments(args=[
    $first, ...
  ])) as $chain where {
    $first <: effect_input_call(),
    not direct_effect_input(call=$chain)
  }
}

// Only the outer call of one dependent chain receives a diagnostic. Searches
// stop at function bodies and arrows so callbacks and methods retain their checks.
predicate inside_dependent_chain($call) {
  $call <: within dependent_chain() as $chain where {
    $chain <: not $call,
    $chain <: JsCallExpression(arguments=JsCallArguments(args=[$first, ...])),
    $first <: contains $call until or {
      JsFunctionBody(),
      JsFunctionExpression(),
      JsArrowFunctionExpression()
    }
  } until or {
    JsFunctionBody(),
    JsFunctionExpression(),
    JsArrowFunctionExpression()
  }
}

// Result construction and inline side-effect wrappers have their own messages.
// This check owns only the complete call, so dependent work inside callbacks
// still receives its nesting diagnostic.
predicate result_or_side_effect_wrapper($call) {
  $call <: or {
    JsCallExpression(callee=`Effect.as`),
    `Effect.andThen($first, $second)` where { $first <: inline_side_effect() }
  }
}

// An inline side effect is the input operation itself. A log inside a nested
// callback does not make the enclosing operation a side-effect wrapper.
pattern inline_side_effect() {
  or {
    native_update(),
    JsCallExpression(callee=`Effect.log$_`),
    `Effect.sync($fn)` where {
      $fn <: JsArrowFunctionExpression(body=native_update())
    }
  }
}

pattern native_update() {
  or {
    `setState($_)`,
    `Atom.set($_)`,
    `invalidate($_)`,
    `console.$method($_)`
  }
}
