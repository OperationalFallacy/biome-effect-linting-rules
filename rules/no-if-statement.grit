file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    or {
        $body <: contains `if ($cond) { $_ }`,
        $body <: contains `if ($cond) $_`
    },
    register_diagnostic(
        span = $cond,
        message = "This rule flags if statements in Effect code to keep the decision and the steps that follow it in one expression. Select the result with Match.value, Option.match, Either.match, or Effect.if, then continue the Effect pipeline.",
        severity = "error"
    )
}
