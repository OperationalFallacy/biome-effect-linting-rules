language js(typescript, jsx)

JsIfStatement(test = $cond) as $branch where {
    $branch <: within JsModule() as $body,
    $body <: contains bubble JsModuleSource() as $moduleSource where {
        $moduleSource <: r".(?:effect(?:/.*)?|@effect/atom-react)."
    },
    $branch <: not within or {
        `Effect.gen($ownerArgs)`,
        `Effect.fn($ownerArgs)`,
        `Effect.fn($ownerName)($ownerBody)`,
        `Effect.fnUntraced($ownerArgs)`,
        `Effect.fnUntracedEager($ownerArgs)`,
        `Effect.suspend($ownerArgs)`
    },
    register_diagnostic(
        span = $cond,
        message = "Use Match.value, Option.match, or Result.match for decisions in value pipelines. Separate branch bodies split the operation's sequence. Keep the selected value and dependent steps together. Effect.gen, Effect.fn, and Effect.suspend bodies support ordinary JavaScript control flow.",
        severity = "error"
    )
}
