file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    or {
        $body <: contains `Effect.sync($fn)` as $call,
        $body <: contains `Effect.sync<$types>($fn)` as $call
    },
    $fn <: `() => $expr`,
    $expr <: `$callee($args)` as $sideEffect,
    not $expr <: `console.$method($_)`,
    register_diagnostic(
        span = $call,
        message = "This Effect.sync wraps a function call. Review what the call does so its role is clear in the operation. Use Effect logging operations for logs, or give this side effect an explicit step in the pipeline.",
        severity = "warning"
    )
}
