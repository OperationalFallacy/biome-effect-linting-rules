file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect/atom-react"`
    },
    or {
        $body <: contains `Effect.sync($fn)` as $call,
        $body <: contains `Effect.sync<$types>($fn)` as $call
    },
    $fn <: `() => $expr`,
    $expr <: `$callee($args)` as $sideEffect,
    not $expr <: `console.$method($_)`,
    register_diagnostic(
        span = $call,
        message = "Make the wrapped operation explicit in the Effect pipeline. A generic Effect.sync callback hides the call's role among the other steps. Use Effect log functions for logs and give updates or other operations a clear pipeline step. Preserve deferred execution and failure behavior through the rewrite.",
        severity = "warning"
    )
}
