file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    $body <: contains `return null` as $ret,
    register_diagnostic(
        span = $ret,
        message = "This rule flags null returns because callers must check for absence before they can use the value. Return Option.none for an absent value or Effect.fail for an error.",
        severity = "error"
    )
}
