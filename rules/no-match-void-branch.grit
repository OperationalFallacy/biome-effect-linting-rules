file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect/atom-react"`
    },
    or {
        $body <: contains `Match.when(true, () => Effect.void)` as $branch,
        $body <: contains `Match.when(false, () => Effect.void)` as $branch,
        $body <: contains `Match.orElse(() => Effect.void)` as $branch
    },
    register_diagnostic(
        span = $branch,
        message = "Separate value selection from skipped Effect work. An Effect.void branch mixes a decision with an empty operation. Select the required value with Match and perform the Effect work afterward. Remove redundant empty branches and preserve the original skip behavior.",
        severity = "error"
    )
}
