language js(typescript, jsx)

or {
  `Match.when(true, () => Effect.void)` as $branch,
  `Match.when(false, () => Effect.void)` as $branch,
  `Match.orElse(() => Effect.void)` as $branch
} where {
  $branch <: within JsModule() as $body,
  $body <: contains JsModuleSource() as $moduleSource where {
    $moduleSource <: r".(?:effect(?:/.*)?|@effect/atom-react)."
  },
  register_diagnostic(span=$branch, message="Use Effect.when for optional Effect work. Pass the condition as an Effect so it runs before the operation, and preserve its failures. Use Effect.asVoid when callers need no result from the conditional operation. Keep Match for pure value selection.", severity="error")
}
