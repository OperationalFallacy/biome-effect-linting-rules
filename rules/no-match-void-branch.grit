file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    or {
        $body <: contains `Match.when(true, () => Effect.void)` as $branch,
        $body <: contains `Match.when(false, () => Effect.void)` as $branch,
        $body <: contains `Match.orElse(() => Effect.void)` as $branch
    },
    register_diagnostic(
        span = $branch,
        message = "This Match branch returns Effect.void, so the Match mixes a value decision with a branch whose only result is to skip work. Remove this empty Match branch, or select a value and perform the Effect operation after the Match.",
        severity = "error"
    )
}
