file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect/atom-react"`
    },
    $body <: contains bubble `Effect.succeed($var)` as $lift where {
        $var <: not `{$_}`,
        $var <: not `[$_]`,
        $var <: not `$_($_)`,
        $var <: not `$_ ? $_ : $_`,
        register_diagnostic(
            span = $lift,
            message = "Select branch values before lifting them into Effect. Wrapping an existing value in Effect.succeed mixes value selection with the operation's Effect steps. Make the decision with Match or Option, then continue in one Effect pipeline. Return previously read state directly from value-only branches. Keep skip decisions explicit instead of disguising them as Option.toArray followed by collection traversal.",
            severity = "warning"
        )
    }
}
