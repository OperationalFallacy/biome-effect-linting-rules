file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    $body <: contains bubble `Effect.succeed($var)` as $lift where {
        $var <: not `{$_}`,
        $var <: not `[$_]`,
        $var <: not `$_($_)`,
        $var <: not `$_ ? $_ : $_`,
        register_diagnostic(
            span = $lift,
            message = "This rule asks you to review Effect.succeed around an existing value because it can turn a simple branch result into another Effect step. Select the branch result with Match or Option, then pass that value into the Effect pipeline. Return state that has already been read as a value. Keep the decision explicit; Option.toArray followed by forEach would express the same branch indirectly.",
            severity = "warning"
        )
    }
}
