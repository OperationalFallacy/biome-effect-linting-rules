file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect/atom-react"`
    },
    $body <: contains bubble `Effect.succeed($var)` as $lift where {
        $var <: not `{$_}`,
        $var <: not `[$_]`,
        $var <: not `$_($_)`,
        $var <: not `$_ ? $_ : $_`,
        register_diagnostic(
            span = $lift,
            message = "Select branch values, then pass them into the Effect flow. Effect.succeed turns a plain branch value into an additional Effect step. Make the decision with Match or Option, then continue in one Effect pipeline. Return previously read state directly from value-only branches. Keep skip decisions explicit. Option.toArray followed by collection traversal hides the same decision inside a loop.",
            severity = "warning"
        )
    }
}
