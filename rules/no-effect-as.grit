file($body) where {
    $body <: contains bubble `Effect.as($value)` as $call where {
        register_diagnostic(
            span = $call,
            message = "Effect.as replaces the preceding result with a supplied value. This rule requires an explicit value transformation or discard step so the result is clear in the pipeline. Use Effect.map to produce the result, or Effect.asVoid to discard it after the preceding steps.",
            severity = "error"
        )
    }
}
