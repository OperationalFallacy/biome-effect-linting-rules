file($body) where {
    $body <: contains bubble `Effect.as($value)` as $call where {
        register_diagnostic(
            span = $call,
            message = "Use Effect.map to produce the result instead of Effect.as. This rule requires result selection to appear in a callback so the pipeline shows how the final value is produced. Use Effect.asVoid to discard the result. Preserve the preceding work and its execution order.",
            severity = "error"
        )
    }
}
