language js(typescript, jsx)

JsCallExpression(callee = `Effect.provide`) as $provide where {
    $provide <: within or {
        `Effect.gen($ownerArgs)`,
        `Effect.fn($ownerArgs)`,
        `Effect.fn($ownerName)($ownerBody)`,
        `Effect.fnUntraced($ownerArgs)`,
        `Effect.fnUntracedEager($ownerArgs)`
    },
    register_diagnostic(
        span = $provide,
        message = "Assemble service dependencies with Layer.provide on the service's layer or exported operation. A method that rebuilds its service graph combines dependency setup with domain work. Define acquisition in the service's make Effect, construct its layer with Layer.effect, and yield dependencies directly in the operation. Keep the application runner's final Effect.provide at application assembly.",
        severity = "error"
    )
}
