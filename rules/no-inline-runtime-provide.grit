language js(typescript, jsx)

JsCallExpression(callee = `Effect.provide`) as $provide where {
    $provide <: within or {
        `Effect.gen($ownerArgs)`,
        `Effect.fn($ownerArgs)`,
        `Effect.fn($ownerName)($ownerBody)`,
        `Effect.fnUntraced($ownerArgs)`,
        `Effect.fnUntracedEager($ownerArgs)`
    },
    $provide <: not within JsCallExpression(callee = $test) where {
        $test <: or {
            `it`, `test`, `it.effect`, `test.effect`, `it.scoped`, `test.scoped`,
            `it.skip`, `test.skip`, `it.only`, `test.only`
        }
    },
    register_diagnostic(
        span = $provide,
        message = "Assemble service dependencies with Layer.provide outside the operation's implementation. Effect.provide inside a reusable operation can acquire and release its layer on every call. Yield dependencies from the operation and provide its layer at application or test assembly. Per-test provision around an exported operation is valid. Keep Effect.provideService for dynamic contextual values.",
        severity = "error"
    )
}
