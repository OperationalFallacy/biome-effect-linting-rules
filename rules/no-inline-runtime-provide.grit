file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    or {
        $body <: contains `function*`,
        $body <: contains `const $name = yield* $runtime.pipe(`,
        $body <: contains `Effect.provide($layer)` as $provide where {
            $provide <: not contains `,`
        }
    },
    or {
        $body <: contains `function*`,
        $body <: contains `return yield* $runtime.pipe(`,
        $body <: contains `Effect.provide($layer)` as $provide where {
            $provide <: not contains `,`
        }
    },
    register_diagnostic(
        span = $provide,
        message = "This Effect.provide supplies a runtime's dependencies inside the local operation, which makes the reader inspect the body to find how the service is assembled. Declare the live dependency on the owning Effect.Service, or provide it once on the exported operation. Then yield the runtime or service directly inside the body.",
        severity = "error"
    )
}
