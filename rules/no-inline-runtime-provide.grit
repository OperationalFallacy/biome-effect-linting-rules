file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    or {
        $body <: contains `function*`,
        $body <: contains `const $name = yield* $runtime.pipe(`,
        $body <: contains `Effect.provide($layer)` as $provide where {
            $provide <: not contains `,`
        }
    },
    or {
        $body <: contains `function*`,
        $body <: contains `return yield* $runtime.pipe(`,
        $body <: contains `Effect.provide($layer)` as $provide where {
            $provide <: not contains `,`
        }
    },
    register_diagnostic(
        span = $provide,
        message = "Assemble dependencies on the service or exported operation instead of inside the method. A local runtime.pipe with Effect.provide mixes dependency setup with the method's work. Declare the live dependency on Effect.Service or provide it once on the exported operation. Yield the configured runtime or service directly in the body.",
        severity = "error"
    )
}
