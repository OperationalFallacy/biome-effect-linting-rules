file($body) where {
    or {
        $body <: contains `"@effect-atom/atom-react"`,
        $body <: contains `Atom.family($...)`
    },
    or {
        $body <: contains `Atom.family($...)` as $familyCall where {
            $familyCall <: contains `get($atom)` as $read,
            $read <: or {
                r".*CollectionAtom\).*",
                r".*ListAtom\).*",
                r".*Visible.*Atom\).*",
                r".*ResultsAtom\).*",
                r".*ReadStateAtom\).*"
            },
            register_diagnostic(
                span = $atom,
                message = "This Atom.family member reads a collection atom. The rule uses atom names to identify a possible row or item projection that depends on the collection it belongs to. For a row or item projection, read a keyed source such as SourceAtom, ByKeyAtom, or IndexAtom. If the family intentionally represents a route or list, rename or restructure it so its role is clear and separate from row or item projections.",
                severity = "error"
            )
        },
        $body <: contains `Atom.family($...)` as $familyCall where {
            $familyCall <: contains `get.get($atom)` as $read,
            $read <: or {
                r".*CollectionAtom\).*",
                r".*ListAtom\).*",
                r".*Visible.*Atom\).*",
                r".*ResultsAtom\).*",
                r".*ReadStateAtom\).*"
            },
            register_diagnostic(
                span = $atom,
                message = "This Atom.family member reads a collection atom. The rule uses atom names to identify a possible row or item projection that depends on the collection it belongs to. For a row or item projection, read a keyed source such as SourceAtom, ByKeyAtom, or IndexAtom. If the family intentionally represents a route or list, rename or restructure it so its role is clear and separate from row or item projections.",
                severity = "error"
            )
        },
        $body <: contains `Atom.family($...)` as $familyCall where {
            $familyCall <: contains `Atom.get($atom)` as $read,
            $read <: or {
                r".*CollectionAtom\).*",
                r".*ListAtom\).*",
                r".*Visible.*Atom\).*",
                r".*ResultsAtom\).*",
                r".*ReadStateAtom\).*"
            },
            register_diagnostic(
                span = $atom,
                message = "This Atom.family member reads a collection atom. The rule uses atom names to identify a possible row or item projection that depends on the collection it belongs to. For a row or item projection, read a keyed source such as SourceAtom, ByKeyAtom, or IndexAtom. If the family intentionally represents a route or list, rename or restructure it so its role is clear and separate from row or item projections.",
                severity = "error"
            )
        }
    }
}
