file($body) where {
    or {
        $body <: contains `"@effect/atom-react"`,
        $body <: contains `Atom.family($...)`
    },
    or {
        $body <: contains `Atom.family($...)` as $familyCall where {
            $familyCall <: contains `get($atom)` as $read,
            $read <: or {
                r".*CollectionAtom\).*",
                r".*ListAtom\).*",
                r".*Visible.*Atom\).*",
                r".*ResultsAtom\).*",
                r".*ReadStateAtom\).*"
            },
            register_diagnostic(
                span = $atom,
                message = "Read keyed sources from row or item atoms. A dependency on the collection couples each item projection to the list. Use a SourceAtom, ByKeyAtom, or IndexAtom for item reads. Keep route and list projections separate, with names that describe that role. This rule identifies collection reads by atom name. A new name for the collection leaves the item dependency intact.",
                severity = "error"
            )
        },
        $body <: contains `Atom.family($...)` as $familyCall where {
            $familyCall <: contains `get.get($atom)` as $read,
            $read <: or {
                r".*CollectionAtom\).*",
                r".*ListAtom\).*",
                r".*Visible.*Atom\).*",
                r".*ResultsAtom\).*",
                r".*ReadStateAtom\).*"
            },
            register_diagnostic(
                span = $atom,
                message = "Read keyed sources from row or item atoms. A dependency on the collection couples each item projection to the list. Use a SourceAtom, ByKeyAtom, or IndexAtom for item reads. Keep route and list projections separate, with names that describe that role. This rule identifies collection reads by atom name. A new name for the collection leaves the item dependency intact.",
                severity = "error"
            )
        },
        $body <: contains `Atom.family($...)` as $familyCall where {
            $familyCall <: contains `Atom.get($atom)` as $read,
            $read <: or {
                r".*CollectionAtom\).*",
                r".*ListAtom\).*",
                r".*Visible.*Atom\).*",
                r".*ResultsAtom\).*",
                r".*ReadStateAtom\).*"
            },
            register_diagnostic(
                span = $atom,
                message = "Read keyed sources from row or item atoms. A dependency on the collection couples each item projection to the list. Use a SourceAtom, ByKeyAtom, or IndexAtom for item reads. Keep route and list projections separate, with names that describe that role. This rule identifies collection reads by atom name. A new name for the collection leaves the item dependency intact.",
                severity = "error"
            )
        }
    }
}
