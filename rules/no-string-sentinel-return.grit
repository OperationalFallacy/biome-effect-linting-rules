language js(typescript, jsx)

`Effect.succeed("$_")` as $sentinel where {
    register_diagnostic(
        span = $sentinel,
        message = "Return an explicit domain outcome instead of a string status through Effect.succeed. String status tokens make callers interpret text to determine what happened. Use the operation's domain result, Option, Either, or a tagged union so callers handle each outcome explicitly. Keep actual text results distinct from status tokens.",
        severity = "error"
    )
}
