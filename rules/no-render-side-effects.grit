file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect/atom-react"`
    },
    $body <: contains `Match.value($cond).pipe($args);` as $call where {
        or {
            $args <: contains `Match.when($_, () => $effect)` as $branch,
            $args <: contains `Match.when($_, () => void $effect)` as $branch,
            $args <: contains `Match.orElse(() => $effect)` as $branch,
            $args <: contains `Match.orElse(() => void $effect)` as $branch
        },
    register_diagnostic(
        span = $call,
        message = "Return the Match result as an expression and move updates or other work out of render. A Match used as a statement runs its selected callback immediately. In a render function, that work runs during render. Keep render expressions pure and perform the work through an Effect runtime action or event handler.",
        severity = "error"
    )
}
}
