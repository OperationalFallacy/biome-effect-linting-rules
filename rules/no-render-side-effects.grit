file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    $body <: contains `Match.value($cond).pipe($args);` as $call where {
        or {
            $args <: contains `Match.when($_, () => $effect)` as $branch,
            $args <: contains `Match.when($_, () => void $effect)` as $branch,
            $args <: contains `Match.orElse(() => $effect)` as $branch,
            $args <: contains `Match.orElse(() => void $effect)` as $branch
        },
    register_diagnostic(
        span = $call,
        message = "This Match call is used as a statement, so its branch callbacks run when the statement executes. In a render function, those callbacks can cause side effects during render. Return the Match result as an expression and run side effects through an Effect runtime action or event handler.",
        severity = "error"
    )
}
}
