file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    $body <: contains `Effect.bind($name, $step)` as $effectBind,
    register_diagnostic(
        span = $effectBind,
        message = "Effect.bind accumulates named fields as the operation proceeds, so the reader must track that object to understand each step's inputs. This rule requires a pipeline or one Effect.gen with direct yields. Supply each step's inputs from the preceding work and keep the sequence in the same operation.",
        severity = "error"
    )
}
