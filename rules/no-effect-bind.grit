language js(typescript, jsx)

JsCallExpression(callee = `Effect.bind`) as $effectBind where {
    $effectBind <: within JsModule() as $body,
    $body <: contains bubble JsModuleSource() as $moduleSource where {
        $moduleSource <: r".(?:effect(?:/.*)?|@effect/atom-react)."
    },
    register_diagnostic(
        span = $effectBind,
        message = "Replace Effect.bind with a pipeline or direct yields in one Effect.gen. Effect.bind accumulates named fields, so the reader must track an intermediate object to understand each step's inputs. Pass results directly to dependent steps and keep the sequence together in the operation.",
        severity = "error"
    )
}
