file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    or {
        $body <: contains `Effect.fn(function* () { $block })` as $call,
        $body <: contains `Effect.fn(function* ($params) { $block })` as $call
    },
    register_diagnostic(
        span = $call,
        message = "Replace the Effect.fn generator wrapper with one pipeline or one Effect.gen. The wrapper adds another function body to inspect for the operation's steps. Keep the steps together and preserve their inputs, execution order, and result.",
        severity = "error"
    )
}
