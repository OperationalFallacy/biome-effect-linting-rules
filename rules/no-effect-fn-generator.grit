file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    or {
        $body <: contains `Effect.fn(function* () { $block })` as $call,
        $body <: contains `Effect.fn(function* ($params) { $block })` as $call
    },
    register_diagnostic(
        span = $call,
        message = "This rule flags generator bodies inside Effect.fn as part of the convention to keep each operation's steps in one pipeline or one Effect.gen. Move the generator's steps into that form and keep their execution order.",
        severity = "error"
    )
}
