language js(typescript, jsx)

JsNewExpression() as $collection where {
    $collection <: within JsModule() as $body,
    or {
        $body <: contains JsImportNamedClause(source = `"effect"`),
        $body <: contains JsImportNamespaceClause(source = $moduleSource) where {
            $moduleSource <: r".effect/.*"
        }
    },
    or {
        $collection <: `new Map<$key, $value>($args)` where {
            $body <: not contains JsIdentifierBinding() as $binding where { $binding <: r"Map" }
        },
        $collection <: `new Set<$key>($args)` where {
            $body <: not contains JsIdentifierBinding() as $binding where { $binding <: r"Set" }
        },
        $collection <: `new globalThis.Map<$key, $value>($args)` where {
            $body <: not contains JsIdentifierBinding() as $binding where { $binding <: r"globalThis" }
        },
        $collection <: `new globalThis.Set<$key>($args)` where {
            $body <: not contains JsIdentifierBinding() as $binding where { $binding <: r"globalThis" }
        }
    },
    or {
        $key <: TsReferenceType(name = `ReturnType`, type_arguments = $keyArgs) where {
            $keyArgs <: contains TsTypeofType(expression_name = $factory),
            $body <: contains `const $factory = $fn`,
            $fn <: JsArrowFunctionExpression(body = $result),
            $result <: or { `({ $fields })`, `[$items]`, `({ $fields } as const)`, `[$items] as const` }
        },
        $key <: or { TsObjectType(), TsTupleType(), TsArrayType() },
        $body <: contains JsClassDeclaration(id = $key, extends_clause = $extends) where {
            or {
                $body <: contains JsImportNamedClause(source = `"effect"`, named_specifiers = $imports) where {
                    or {
                        $imports <: contains JsShorthandNamedImportSpecifier(local_name = $data) where { $data <: `Data` },
                        $imports <: contains JsNamedImportSpecifier(name = $imported, local_name = $data) where { $imported <: r"Data" }
                    }
                },
                $body <: contains JsImportNamespaceClause(source = `"effect/Data"`, namespace_specifier = JsNamespaceImportSpecifier(local_name = $data))
            },
            $body <: not contains JsFormalParameter(binding = $data),
            $body <: not contains JsVariableDeclarator(id = $data),
            $extends <: contains `$data.Class`
        }
    },
    register_diagnostic(
        span = $collection,
        message = "Use HashMap or HashSet for keys that require structural equality. Effect v4 compares plain objects and arrays by value, while native Map and Set compare object keys by reference. A newly constructed equal key therefore misses the native collection's stored entry. Keep native collections for deliberate instance identity. Values created with Equal.byReference retain that identity behavior.",
        severity = "warn"
    )
}
