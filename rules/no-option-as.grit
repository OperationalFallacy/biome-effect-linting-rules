file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    $body <: contains bubble `Option.as($value, $result)` as $call where {
        register_diagnostic(
            span = $call,
            message = "Option.as replaces the value inside Some with a supplied result. This rule requires the value selection to appear in a callback. Use Option.map or Option.match to return the selected value.",
            severity = "error"
        )
    }
}
