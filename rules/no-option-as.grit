language js(typescript, jsx)

JsCallExpression(callee=`Option.as`) as $call where {
  $call <: within JsModule() as $body,
  $body <: contains JsModuleSource() as $moduleSource where {
    $moduleSource <: r".(?:effect(?:/.*)?|@effect/atom-react)."
  },
  register_diagnostic(span=$call, message="Replace Option.as with Option.map or Option.match. This rule requires value selection to appear in a callback so the result choice is explicit. Return the selected value from the callback and preserve the Option's absence behavior.", severity="error")
}
