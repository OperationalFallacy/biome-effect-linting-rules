language js(typescript, jsx)

or {
    `const $name = Effect.$outer($first)` as $outerCall,
    `const $name: $type = Effect.$outer($first)` as $outerCall,
    `const $name = Effect.$outer($first, $second)` as $outerCall,
    `const $name: $type = Effect.$outer($first, $second)` as $outerCall,
    `return Effect.$outer($first)` as $outerCall,
    `return Effect.$outer($first, $second)` as $outerCall
} where {
    or {
        $first <: `Effect.$inner($innerOnly)` where {
            $innerOnly <: `Effect.$deep($_)`
        },
        $first <: `Effect.$inner($innerFirst, $innerSecond)` where {
            $innerFirst <: `Effect.$deep($_)`
        }
    },
    register_diagnostic(
        span = $outerCall,
        message = "Flatten nested Effect combinators into one pipeline. The nested calls require reading from the inside out to reconstruct execution order. Build shared inputs once with Effect.all or Effect.map, then sequence the dependent steps in the pipeline. Preserve dependencies between steps and the operation's failure behavior.",
        severity = "error"
    )
}
