file($body) where {
    $body <: contains bubble JsModuleSource() as $moduleSource where {
        $moduleSource <: r".(?:effect(?:/.*)?|@effect/atom-react)."
    },
    $body <: contains `(($param) => $inner)($arg)` where {
        $inner <: contains `(($param2) => $_)($_)` as $nested
    },
    register_diagnostic(
        span = $nested,
        message = "Replace nested immediately invoked functions with local values and one pipeline. The nested function bodies make the operation's execution order harder to follow. Bind intermediate values with const, select the result with Match or Option, and continue the operation after that decision.",
        severity = "error"
    )
}
