file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    $body <: contains `(($param) => $inner)($arg)` where {
        $inner <: contains `(($param2) => $_)($_)` as $nested
    },
    register_diagnostic(
        span = $nested,
        message = "Nested immediately invoked functions make the execution order harder to follow. Assign their intermediate values to local constants, select the result with one Match or Option decision, and continue in one pipeline.",
        severity = "error"
    )
}
