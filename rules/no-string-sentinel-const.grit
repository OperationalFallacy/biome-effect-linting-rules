language js(typescript, jsx)

`const $name = $val` as $sentinel where {
    $val <: `"$_"`,
    register_diagnostic(
        span = $sentinel,
        message = "This rule treats string constants as potential status tokens. A status token makes callers interpret a string to decide what happened. For a status, represent the outcome with a domain value, a tagged union, Option, or Either so callers can handle each case explicitly.",
        severity = "error"
    )
}
