file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect/atom-react"`
    },
    $body <: contains `type $name = $value` where {
        $value <: contains `Effect.Effect` as $effect,
    register_diagnostic(
        span = $effect,
        message = "Put the Effect type directly on the service method or function signature instead of a separate alias. The alias requires another lookup to inspect the operation's result, errors, and dependencies. Keep that contract beside the operation, or inline the type at its use.",
        severity = "error"
    )
}
}
