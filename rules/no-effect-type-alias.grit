file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    $body <: contains `type $name = $value` where {
        $value <: contains `Effect.Effect` as $effect,
    register_diagnostic(
        span = $effect,
        message = "This alias puts an operation's Effect type behind another name, so the reader must find the alias to inspect the operation's result, errors, and dependencies. Put the Effect type on the service method or function signature so those types appear with the operation.",
        severity = "error"
    )
}
}
