language js(typescript, jsx)

// The no-effect-type-alias rule keeps implemented channels inferred and
// required public contracts at their service or interface operation.
`Effect.Effect` as $effect where {
  $effect <: within `type $name = $value`,
  $effect <: within JsModule() as $body,
  $body <: contains JsModuleSource() as $moduleSource where {
    $moduleSource <: r".(?:effect(?:/.*)?|@effect/atom-react)."
  },
  register_diagnostic(span=$effect, message="This preset keeps Effect channels beside their operation instead of in a separate alias. The alias adds another lookup to inspect the result, errors, and dependencies. Infer channels from the implementation, or declare a required public contract on Context.Service or an interface.", severity="error")
}
