file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    $body <: contains `Effect.Do` as $effectDo,
    register_diagnostic(
        span = $effectDo,
        message = "This rule flags Effect.Do builders because the reader must follow the accumulated fields to understand each step's inputs. Replace this Effect.Do builder with a pipeline or one Effect.gen, and keep the steps in execution order.",
        severity = "error"
    )
}
