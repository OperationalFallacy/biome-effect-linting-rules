language js(typescript, jsx)

or {
    or {
        `const $name = Effect.flatMap($args)` as $call,
        `const $name: $type = Effect.flatMap($args)` as $call,
        `return Effect.flatMap($args)` as $call
    } where {
        $args <: contains `Effect.flatMap($_)` until JsFunctionExpression(),
        register_diagnostic(
            span = $call,
            message = "Combine nested Effect.flatMap calls into one pipeline. The reader must follow separate callback bodies to understand the dependent steps and their execution order. Build shared inputs once with Effect.all or Effect.map, then pass them through the dependent steps in order.",
            severity = "warn"
        )
    },
    or {
        `const $name = Effect.flatten($outer)` as $call,
        `const $name: $type = Effect.flatten($outer)` as $call,
        `return Effect.flatten($outer)` as $call
    } where {
        $outer <: contains `Effect.map($_)`,
        register_diagnostic(
            span = $call,
            message = "Replace Effect.map followed by Effect.flatten with Effect.flatMap. The map produces an Effect and the flatten joins it. The pair splits one transformation across two calls. Effect.flatMap expresses that transformation directly.",
            severity = "warn"
        )
    }
}
