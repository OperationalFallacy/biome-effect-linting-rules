language js(typescript, jsx)

or {
    JsCallExpression(callee = `Effect.flatMap`, arguments = JsCallArguments(args = $args)) as $call where {
        or {
            $args <: [JsCallExpression(callee = `Effect.flatMap`), ...],
            and {
                $args <: [..., JsArrowFunctionExpression(body = $body)],
                $body <: or {
                    JsCallExpression(callee = `Effect.flatMap`),
                    JsFunctionBody(statements = [`return Effect.flatMap($innerArgs)`])
                }
            }
        },
        register_diagnostic(
            span = $call,
            message = "Use one pipeline or Effect.gen for these dependent steps. Nested Effect.flatMap callbacks obscure their order. Use Effect.all only to collect independent results.",
            severity = "warn"
        )
    },
    or {
        JsCallExpression(callee = `Effect.flatten`, arguments = JsCallArguments(args = [JsCallExpression(callee = `Effect.map`)])) as $call,
        `Effect.map($args).pipe(Effect.flatten)` as $call
    } where {
        register_diagnostic(
            span = $call,
            message = "Replace Effect.map followed by Effect.flatten with Effect.flatMap. The map produces an Effect and the flatten joins it. Effect.flatMap expresses that transformation directly.",
            severity = "warn"
        )
    }
}
