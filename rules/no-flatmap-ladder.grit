language js(typescript, jsx)

or {
    or {
        `const $name = Effect.flatMap($args)` as $call,
        `const $name: $type = Effect.flatMap($args)` as $call,
        `return Effect.flatMap($args)` as $call
    } where {
        $args <: contains `Effect.flatMap($_)`,
        register_diagnostic(
            span = $call,
            message = "These nested Effect.flatMap calls spread one operation across several callback bodies. Build shared inputs with Effect.all or Effect.map, then combine the dependent steps into one pipeline.",
            severity = "warning"
        )
    },
    or {
        `const $name = Effect.flatten($outer)` as $call,
        `const $name: $type = Effect.flatten($outer)` as $call,
        `return Effect.flatten($outer)` as $call
    } where {
        $outer <: contains `Effect.map($_)`,
        register_diagnostic(
            span = $call,
            message = "Effect.map followed by Effect.flatten uses two operations to produce and then flatten an Effect. Replace Effect.map followed by Effect.flatten with Effect.flatMap, which expresses both steps in one call.",
            severity = "warning"
        )
    }
}
