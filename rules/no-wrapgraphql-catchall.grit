file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect/atom-react"`
    },
    $body <: contains bubble `$target.pipe($ops)` where {
        $ops <: contains `Effect.catch($handler)` as $catch,
        or {
            $ops <: contains bubble `wrapGraphqlCall($args)`,
            $ops <: contains `Effect.flatMap(applyResponse)`,
            $target <: contains bubble `$inner.pipe($innerOps)` where {
                $innerOps <: contains bubble `wrapGraphqlCall($args)`
            },
            $target <: contains bubble `$inner.pipe($innerOps)` where {
                $innerOps <: contains `Effect.flatMap(applyResponse)`
            }
        },
        register_diagnostic(
            span = $catch,
            message = "Handle GraphQL errors in the response mapper. wrapGraphqlCall and applyResponse already expose structured GraphQL errors. An additional Effect.catch hides the distinction between those outcomes. Preserve each error's information and meaning in the response mapper.",
            severity = "error"
        )
    },
    $body <: contains bubble `pipe($args)` where {
        $args <: contains `Effect.catch($handler)` as $catch,
        or {
            $args <: contains bubble `wrapGraphqlCall($callArgs)`,
            $args <: contains `Effect.flatMap(applyResponse)`
        },
        register_diagnostic(
            span = $catch,
            message = "Handle GraphQL errors in the response mapper. wrapGraphqlCall and applyResponse already expose structured GraphQL errors. An additional Effect.catch hides the distinction between those outcomes. Preserve each error's information and meaning in the response mapper.",
            severity = "error"
        )
    }
}
