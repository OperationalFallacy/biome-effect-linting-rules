file($body) where {
    or {
        $body <: contains `"effect"`,
        $body <: contains bubble `import "effect/$module"`,
        $body <: contains `"@effect-atom/atom-react"`
    },
    $body <: contains `Effect.never` as $never,
    register_diagnostic(
        span = $never,
        message = "Effect.never waits until interruption, so any resources held by the operation depend on cancellation and cleanup elsewhere. This rule requires that lifetime to be explicit. Use Stream or acquire/release to define when this operation ends and how it releases resources.",
        severity = "error"
    )
}
