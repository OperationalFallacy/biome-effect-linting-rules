file($body) where {
    $body <: contains bubble JsModuleSource() as $moduleSource where {
        $moduleSource <: r".(?:effect(?:/.*)?|@effect/atom-react)."
    },
    $body <: contains `Effect.never` as $never,
    register_diagnostic(
        span = $never,
        message = "Give this long-lived operation an explicit lifetime and cleanup. Effect.never waits for interruption and leaves termination to cancellation elsewhere. Use Stream or acquire/release to express the operation's lifetime and resource release together.",
        severity = "error"
    )
}
