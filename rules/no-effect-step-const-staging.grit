language js(typescript, jsx)

or {
    `const $name = $value;` as $statement,
    `const $name: $type = $value;` as $statement
} where {
    // Match this initializer, not declarations nested inside a factory or callback.
    or {
        $value <: `Effect.$method($args)`,
        $value <: `pipe($args)` where {
            $value <: contains `Effect.$method($effectArgs)`
        },
        $value <: `$source.pipe($steps)` where {
            $value <: contains `Effect.$method($effectArgs)`
        }
    },
    $value <: not or {
        `Effect.fn($args)`,
        `Effect.fnUntraced($args)`,
        `Effect.fnUntracedEager($args)`
    },
    $statement <: not within or {
        JsModule(items = $scopeItems),
        JsFunctionBody(statements = $scopeItems),
        JsBlockStatement(statements = $scopeItems)
    } where {
        $scopeItems <: [..., $statement, ...],
        $scopeItems <: contains or {
            `Layer.effect($_, $name)`,
            `Layer.effect($_)($name)`,
            `Context.Service<$serviceTypes>()($key, $options)` where {
                $options <: JsObjectExpression(members = $optionsMembers),
                $optionsMembers <: [..., JsPropertyObjectMember(name = `make`, value = $name), ...]
            }
        } until or { JsFunctionBody(), JsBlockStatement(), JsArrowFunctionExpression() }
    } until or { JsFunctionBody(), JsBlockStatement(), JsModule() },
    // Only the nearest lexical scope's direct API return establishes membership.
    $statement <: not within JsFunctionBody(statements = $statements) where {
        $statements <: [..., $statement, ...],
        $statements <: [..., `return { $members }`, ...],
        $members <: [..., or {
            JsShorthandPropertyObjectMember(name = $name),
            JsPropertyObjectMember(value = $name)
        }, ...]
    } until or { JsFunctionBody(), JsBlockStatement() },
    register_diagnostic(
        span = $statement,
        message = "Inline intermediate Effect steps into the operation's pipeline. The reader must follow separate constant declarations to reconstruct validation, decisions, and dependent work. Use Effect.flatMap or Effect.andThen to connect dependent steps. Keep complete service constructors and operations exposed through the service's returned API. Exported Effect values and functions defined with Effect.fn or Effect.fnUntraced are valid API operations. Local constants for final domain values remain valid.",
        severity = "error"
    )
}
