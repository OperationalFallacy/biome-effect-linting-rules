language js(typescript, jsx)

// The no-effect-step-const-staging rule reports named intermediate Effects.
// Complete service constructors and operations returned through an API remain
// valid. Each exception applies to the declaration's own lexical scope.
or {
  `const $name = $value;` as $statement,
  `const $name: $type = $value;` as $statement
} where {
  $value <: effect_step(),
  not service_constructor(statement=$statement, name=$name),
  not returned_operation(statement=$statement, name=$name),
  not nested_generator(value=$value),
  register_diagnostic(span=$statement, message="Inline intermediate Effect steps into the operation's pipeline. The reader must follow separate constant declarations to reconstruct validation, decisions, and dependent work. Use Effect.flatMap or Effect.andThen to connect dependent steps. Keep complete service constructors and operations exposed through the service's returned API. Exported Effect values and functions defined with Effect.fn or Effect.fnUntraced are valid API operations. Local constants for final domain values remain valid.", severity="error")
}

// The effect_step pattern matches Effect calls and both pipeline forms.
// Effect.fn variants define complete operations and do not count as steps.
pattern effect_step() {
  or {
    `Effect.$method($args)`,
    `pipe($args)` as $value where {
      $value <: contains `Effect.$method($effectArgs)`
    },
    `$source.pipe($steps)` as $value where {
      $value <: contains `Effect.$method($effectArgs)`
    }
  } as $value where {
    $value <: not or {
      `Effect.fn($args)`,
      `Effect.fnUntraced($args)`,
      `Effect.fnUntracedEager($args)`
    }
  }
}

// The service_constructor predicate recognizes a declaration consumed by
// Layer.effect or Context.Service's make option in the same lexical scope.
// Nested functions and blocks cannot exempt a declaration in an outer scope.
predicate service_constructor($statement, $name) {
  $statement <: within or {
    JsModule(items=$scopeItems),
    JsFunctionBody(statements=$scopeItems),
    JsBlockStatement(statements=$scopeItems)
  } where {
    $scopeItems <: [..., $statement, ...],
    $scopeItems <: contains or {
      `Layer.effect($_, $name)`,
      `Layer.effect($_)($name)`,
      `Context.Service<$serviceTypes>()($key, $options)` where {
        $options <: JsObjectExpression(members=$optionsMembers),
        $optionsMembers <: [
          ..., JsPropertyObjectMember(name=`make`, value=$name), ...
        ]
      }
    } until or {
      JsFunctionBody(),
      JsBlockStatement(),
      JsArrowFunctionExpression()
    }
  } until or {
    JsFunctionBody(),
    JsBlockStatement(),
    JsModule()
  }
}

// The returned_operation predicate recognizes a direct member of the object
// returned by the declaration's function. Returns in nested functions, blocks,
// or nested objects cannot establish that relationship.
predicate returned_operation($statement, $name) {
  $statement <: within JsFunctionBody(statements=$statements) where {
    $statements <: [..., $statement, ...],
    $statements <: [..., `return { $members }`, ...],
    $members <: [
      ...,
      or {
        JsShorthandPropertyObjectMember(name=$name),
        JsPropertyObjectMember(value=$name)
      },
      ...
    ]
  } until or {
    JsFunctionBody(),
    JsBlockStatement()
  }
}

// The nested-generator rule reports a generator declaration inside the current
// operation. Defer that complete pattern to its specific nesting diagnostic.
// Function callbacks have their own operation scope and remain independently checked.
predicate nested_generator($value) {
  $value <: `Effect.gen($_)`,
  $value <: within JsModule() as $module,
  $module <: contains JsModuleSource() as $source where {
    $source <: r".(?:effect(?:/.*)?|@effect/atom-react)."
  },
  $value <: within `Effect.gen(function* () { $body })` where {
    $body <: contains $value until or {
      JsFunctionExpression(),
      JsArrowFunctionExpression()
    }
  }
}
