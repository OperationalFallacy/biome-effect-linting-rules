file($body) where {
    $body <: contains bubble `import($module)` as $dynamicImport where {
        register_diagnostic(
            span = $dynamicImport,
            message = "Replace the dynamic import with a static import. A module load inside the operation forces the reader to inspect the execution path to identify the dependency. Declare the dependency with the file's other imports and update its uses.",
            severity = "error"
        )
    }
}
