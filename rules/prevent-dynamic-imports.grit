file($body) where {
    $body <: contains bubble `import($module)` as $dynamicImport where {
        register_diagnostic(
            span = $dynamicImport,
            message = "Replace the dynamic import with a static import. Loading the module inside the operation separates the dependency from the file's declared imports and adds a load step to the execution path. Declare the dependency with the file's other imports and update its uses.",
            severity = "error"
        )
    }
}
