{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "json": {
    "formatter": {
      "expand": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "recommended": false,
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [
                ":BUN:",
                ":NODE:"
              ],
              ":BLANK_LINE:",
              ":URL:",
              [
                ":PACKAGE:",
                ":PACKAGE_WITH_PROTOCOL:",
                "!effect/**",
                "!@effect/**"
              ],
              ":BLANK_LINE:",
              [
                "effect/**",
                "@effect/**"
              ],
              ":BLANK_LINE:",
              ":URL:",
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      ".projenrc.ts",
      "bin/**",
      "scripts/**",
      "src/**",
      "tests/**/*.test.ts",
      "tests/support/**",
      "vitest.config.mts",
      "!!refs",
      "!!.local",
      "!!dist",
      "!!lib"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useConst": "error"
      },
      "complexity": {
        "useArrowFunction": "off"
      }
    }
  },
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
